<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



  <!-- Colores base -->
  <Color x:Key="Col.Bg">#06120C</Color>
  <Color x:Key="Col.Panel">#0B1D14</Color>
  <Color x:Key="Col.Card">#10281B</Color>
  <Color x:Key="Col.Border">#1F4A33</Color>
  <Color x:Key="Col.Text">#EAF7EF</Color>
  <Color x:Key="Col.TextDim">#9CC3AD</Color>

  <!-- Acentos p�ker -->
  <Color x:Key="Col.Accent">#34D399</Color>
  <Color x:Key="Col.Heart">#E24E5B</Color>
  <Color x:Key="Col.Diamond">#E3B341</Color>
  <Color x:Key="Col.Club">#229A5E</Color>
  <Color x:Key="Col.Glow">#5534D399</Color>
  <Color x:Key="Col.GlowTransparent">#0034D399</Color>


  <SolidColorBrush x:Key="BgDark"
      Color="#0B1D14"/>
  <SolidColorBrush x:Key="PanelDark"
      Color="#0B1D14"/>
  <SolidColorBrush x:Key="BorderDark"
      Color="#1F4A33"/>
  <SolidColorBrush x:Key="FgLight"
      Color="#EAF7EF"/>
  <SolidColorBrush x:Key="FgDim"
      Color="#9CC3AD"/>
  <SolidColorBrush x:Key="FgAccent"
      Color="#229A5E"/>

  <SolidColorBrush x:Key="HudBlueDark"
      Color="#2F6FB3"/>
  <SolidColorBrush x:Key="HudBlue"
      Color="#0E8F8A"/>
  <SolidColorBrush x:Key="HudGreenSoft"
      Color="#2E9152"/>
  <SolidColorBrush x:Key="HudYellow"
      Color="#B08A1E"/>
  <SolidColorBrush x:Key="HudOrange"
      Color="#C46A24"/>
  <SolidColorBrush x:Key="HudRedSoft"
      Color="#C94A55"/>
  <SolidColorBrush x:Key="HudRed"
      Color="#9B2C38"/>

  <SolidColorBrush x:Key="HeroRow"
      Color="#14402A"/>
  <SolidColorBrush x:Key="HeroRowSelected"
      Color="#1D5C3C"/>
  <SolidColorBrush x:Key="HeroRowAccent"
      Color="#6EE7B7"/>

  <SolidColorBrush x:Key="BtnBg"
      Color="#229A5E"/>
  <SolidColorBrush x:Key="BtnBgHover"
      Color="#197346"/>
  <SolidColorBrush x:Key="BtnFg"
      Color="#FFFFFF"/>


  <!-- Brushes -->
  <SolidColorBrush x:Key="Brush.Bg"
      Color="{StaticResource Col.Bg}"/>
  <SolidColorBrush x:Key="Brush.Panel"
      Color="{StaticResource Col.Panel}"/>
  <SolidColorBrush x:Key="Brush.Card"
      Color="{StaticResource Col.Card}"/>
  <SolidColorBrush x:Key="Brush.Border"
      Color="{StaticResource Col.Border}"/>
  <SolidColorBrush x:Key="Brush.Text"
      Color="{StaticResource Col.Text}"/>
  <SolidColorBrush x:Key="Brush.TextDim"
      Color="{StaticResource Col.TextDim}"/>
  <SolidColorBrush x:Key="Brush.Accent"
      Color="{StaticResource Col.Accent}"/>
  <SolidColorBrush x:Key="Brush.Club"
      Color="{StaticResource Col.Club}"/>
  <SolidColorBrush x:Key="Brush.Surface"
      Color="#0E271B"/>
  <SolidColorBrush x:Key="Brush.SurfaceText"
      Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Inset"
      Color="#0B1D14"/>
  <SolidColorBrush x:Key="Brush.Header"
      Color="#0D2016"/>
  <SolidColorBrush x:Key="Brush.HeaderBorder"
      Color="#23553A"/>
  <SolidColorBrush x:Key="Brush.CardHover"
      Color="#122F1F"/>
  <SolidColorBrush x:Key="Brush.RowHover"
      Color="#0E2519"/>
  <SolidColorBrush x:Key="Brush.RowSelected"
      Color="#4434D399"/>
  <SolidColorBrush x:Key="Brush.AccentSoft"
      Color="#1E34D399"/>
  <SolidColorBrush x:Key="Brush.Positive"
      Color="#34D399"/>
  <SolidColorBrush x:Key="Brush.Negative"
      Color="#E24E5B"/>
  <SolidColorBrush x:Key="Brush.Warning"
      Color="#E3B341"/>

  <FontFamily x:Key="Font.UI">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Symbol">Segoe UI Symbol</FontFamily>

  <VisualBrush x:Key="Brush.AppShell" Stretch="Fill">
    <VisualBrush.Visual>
      <Grid Width="1440" Height="900" ClipToBounds="True">
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource Col.Bg}" Offset="0"/>
            <GradientStop Color="{DynamicResource Col.Panel}" Offset="0.58"/>
            <GradientStop Color="{DynamicResource Col.Card}" Offset="1"/>
          </LinearGradientBrush>
        </Grid.Background>

        <!-- Solo el fondo inicial: ThemePaletteManager lo reemplaza con los colores del aspecto. -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="560"
                Height="420"
                Margin="0,0,-130,-150"
                Opacity="0.42"
                IsHitTestVisible="False">
          <Border.Background>
            <RadialGradientBrush GradientOrigin="0.72,0.74" Center="0.72,0.74" RadiusX="0.78" RadiusY="0.78">
              <GradientStop Color="{DynamicResource Col.Glow}" Offset="0"/>
              <GradientStop Color="{DynamicResource Col.Glow}" Offset="0.36"/>
              <GradientStop Color="{DynamicResource Col.GlowTransparent}" Offset="1"/>
            </RadialGradientBrush>
          </Border.Background>
        </Border>
      </Grid>
    </VisualBrush.Visual>
  </VisualBrush>

  <DataTemplate x:Key="CardChipListTemplate">
    <ItemsControl ItemsSource="{Binding}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Width="20"
                  Height="24"
                  Margin="1,0"
                  CornerRadius="3"
                  Background="{Binding Background}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="1">
            <TextBlock Text="{Binding Rank}"
                       Foreground="{Binding Foreground}"
                       FontSize="15"
                       FontWeight="Black"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>

  <!-- Base -->
  <Style TargetType="Window">
    <Setter Property="Background"
        Value="{DynamicResource Brush.AppShell}"/>
    <Setter Property="Foreground"
        Value="{DynamicResource Brush.Text}"/>
    <Setter Property="FontFamily"
        Value="{StaticResource Font.UI}"/>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping"
        Value="Wrap"/>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background"
        Value="{DynamicResource Brush.Border}"/>
    <Setter Property="Height"
        Value="1"/>
    <Setter Property="Margin"
        Value="0,8,0,8"/>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Placement" Value="Right"/>
    <Setter Property="HorizontalOffset" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Brush.Inset}"
                  BorderBrush="{DynamicResource Brush.Accent}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="11,8"
                  MaxWidth="260">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18"
                                ShadowDepth="0"
                                Opacity="0.42"
                                Color="#000000"/>
            </Border.Effect>
            <Grid>
              <Border Width="3"
                      CornerRadius="2"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource Brush.Accent}"
                      Opacity="0.95"/>
              <ContentPresenter Margin="12,0,0,0"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FunctionToolTipStyle" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
    <Setter Property="Placement" Value="Right"/>
    <Setter Property="HorizontalOffset" Value="12"/>
    <Setter Property="VerticalOffset" Value="-2"/>
  </Style>

  <Style x:Key="FunctionTipTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style x:Key="FunctionTipDetail" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="PanelCard" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="{DynamicResource Col.Card}" Offset="0"/>
          <GradientStop Color="{DynamicResource Col.Panel}" Offset="0.42"/>
          <GradientStop Color="{DynamicResource Col.Bg}" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="18"
                          ShadowDepth="0"
                          Opacity="0.26"
                          Color="#000000"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ProjectPanelBorder" TargetType="Border" BasedOn="{StaticResource PanelCard}">
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="14"/>
  </Style>

  <Style x:Key="PanelBorder" TargetType="Border" BasedOn="{StaticResource ProjectPanelBorder}"/>

  <Style x:Key="GlowPanelShell" TargetType="Grid">
    <Setter Property="Margin" Value="6,10,6,16"/>
  </Style>

  <Style x:Key="PanelBackGlow" TargetType="Border">
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Opacity" Value="0.78"/>
    <Setter Property="Margin" Value="10,18,-14,-12"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Background">
      <Setter.Value>
        <RadialGradientBrush GradientOrigin="0.88,0.92" Center="0.88,0.92" RadiusX="0.9" RadiusY="0.9">
          <GradientStop Color="{DynamicResource Col.Glow}" Offset="0"/>
          <GradientStop Color="{DynamicResource Col.Glow}" Offset="0.42"/>
          <GradientStop Color="{DynamicResource Col.GlowTransparent}" Offset="1"/>
        </RadialGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Effect">
      <Setter.Value>
        <BlurEffect Radius="22"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MiniCardBackGlow" TargetType="Border">
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Opacity" Value="0.42"/>
    <Setter Property="Margin" Value="14,16,-5,-5"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Background">
      <Setter.Value>
        <RadialGradientBrush GradientOrigin="0.9,0.95" Center="0.9,0.95" RadiusX="0.8" RadiusY="0.8">
          <GradientStop Color="{DynamicResource Col.Glow}" Offset="0"/>
          <GradientStop Color="{DynamicResource Col.Glow}" Offset="0.44"/>
          <GradientStop Color="{DynamicResource Col.GlowTransparent}" Offset="1"/>
        </RadialGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Effect">
      <Setter.Value>
        <BlurEffect Radius="12"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BrandWatermarkText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style x:Key="DashboardMetricCard" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="{DynamicResource Col.Card}" Offset="0"/>
          <GradientStop Color="{DynamicResource Col.Panel}" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="8"
                          ShadowDepth="0"
                          Opacity="0.16"
                          Color="#000000"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CockpitRail" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="{DynamicResource Col.Panel}" Offset="0"/>
          <GradientStop Color="{DynamicResource Col.Bg}" Offset="0.52"/>
          <GradientStop Color="{DynamicResource Col.Panel}" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>

  <Style x:Key="HeroMetricPill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Inset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <Style x:Key="SectionEyebrow" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style x:Key="SectionHeading" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style x:Key="GridHeaderText" TargetType="TextBlock">
    <Setter Property="Background" Value="{DynamicResource Brush.Header}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="5,4"/>
  </Style>

  <Style x:Key="StatCellText" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Padding" Value="5,2"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="StatGlowText" TargetType="TextBlock" BasedOn="{StaticResource StatCellText}">
    <Setter Property="Margin" Value="4,3"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="MinWidth" Value="48"/>
    <Setter Property="Opacity" Value="0.96"/>
  </Style>

  <!-- Controles claros embebidos en popups: el calendario no debe heredar texto claro. -->
  <Style TargetType="Calendar">
    <Setter Property="Foreground" Value="Black"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
  </Style>

  <Style TargetType="CalendarDayButton">
    <Setter Property="Foreground" Value="Black"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="MinWidth" Value="22"/>
    <Setter Property="MinHeight" Value="18"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarDayButton">
          <Border x:Name="DayBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="2"
                  Padding="2">
            <TextBlock Text="{TemplateBinding Content}"
                       Foreground="{DynamicResource Brush.SurfaceText}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource Brush.Card}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
              <Setter TargetName="DayBorder" Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CalendarButton">
    <Setter Property="Foreground" Value="Black"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarButton">
          <Border x:Name="CalendarButtonBorder"
                  Background="{TemplateBinding Background}"
                  CornerRadius="3"
                  Padding="4">
            <TextBlock Text="{TemplateBinding Content}"
                       Foreground="{DynamicResource Brush.SurfaceText}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CalendarButtonBorder" Property="Background" Value="{DynamicResource Brush.Card}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- HERO -->
  <Style x:Key="HeroCard"
      TargetType="Border">
    <Setter Property="Background"
        Value="{DynamicResource Brush.Card}"/>
    <Setter Property="BorderBrush"
        Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness"
        Value="1"/>
    <Setter Property="CornerRadius"
        Value="14"/>
    <Setter Property="Padding"
        Value="22"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="16"
            ShadowDepth="0"
            Opacity="0.24"
            Color="#000000"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Bot�n carta -->
  <Style x:Key="CardButton"
      TargetType="Button">
    <Setter Property="Foreground"
        Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background"
        Value="{DynamicResource Brush.Card}"/>
    <Setter Property="BorderBrush"
        Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness"
        Value="1"/>
    <Setter Property="Padding"
        Value="16"/>
    <Setter Property="FontSize"
        Value="16"/>
    <Setter Property="Cursor"
        Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="14"
              Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
              <Rectangle x:Name="glow"
                  RadiusX="14"
                  RadiusY="14"
                  Opacity="0">
                <Rectangle.Fill>
                  <RadialGradientBrush GradientOrigin="0.5,0.5"
                      Center="0.5,0.5"
                      RadiusX="0.8"
                      RadiusY="0.8">
                    <GradientStop Color="{DynamicResource Col.Glow}"
                        Offset="0"/>
                    <GradientStop Color="{DynamicResource Col.GlowTransparent}"
                        Offset="1"/>
                  </RadialGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                Value="True">
              <Setter TargetName="bd"
                  Property="Background"
                  Value="{DynamicResource Brush.Panel}"/>
              <Setter TargetName="bd"
                  Property="BorderBrush"
                  Value="{DynamicResource Brush.Border}"/>
              <Setter TargetName="glow"
                  Property="Opacity"
                  Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed"
                Value="True">
              <Setter TargetName="bd"
                  Property="Background"
                  Value="{DynamicResource Brush.Inset}"/>
            </Trigger>
            <Trigger Property="IsEnabled"
                Value="False">
              <Setter Property="Opacity"
                  Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CardButton.Secondary"
      BasedOn="{StaticResource CardButton}"
      TargetType="Button">
    <Setter Property="Background"
        Value="{DynamicResource Brush.Inset}"/>
    <Setter Property="BorderBrush"
        Value="{DynamicResource Brush.Border}"/>
  </Style>

  <!-- === Bot�n primario para los slots (FALTABA) === -->
  <Style TargetType="Button"
      x:Key="Btn.Primary">
    <Setter Property="Foreground"
        Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background"
        Value="{DynamicResource Brush.Card}"/>
    <Setter Property="BorderBrush"
        Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness"
        Value="1"/>
    <Setter Property="Padding"
        Value="12,8"/>
    <Setter Property="FontWeight"
        Value="SemiBold"/>
    <Setter Property="Cursor"
        Value="Hand"/>
    <Setter Property="FocusVisualStyle"
        Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels"
        Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <!-- Boton limpio: superficie de tarjeta, borde fino y realce del color del tema al pasar.
             Antes llevaba una raya de color fija en la parte de arriba que parecia una barra de progreso. -->
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                Value="True">
              <Setter TargetName="Root" Property="Background"
                  Value="{DynamicResource Brush.CardHover}"/>
              <Setter TargetName="Root" Property="BorderBrush"
                  Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused"
                Value="True">
              <Setter TargetName="Root" Property="BorderBrush"
                  Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed"
                Value="True">
              <Setter TargetName="Root" Property="Background"
                  Value="{DynamicResource Brush.Inset}"/>
            </Trigger>
            <Trigger Property="IsEnabled"
                Value="False">
              <Setter Property="Opacity"
                  Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="HorizontalContentAlignment"
        Value="Center"/>
    <Setter Property="VerticalContentAlignment"
        Value="Center"/>
  </Style>

  <!-- Boton de accion principal (Entrar, Guardar, Analizar): relleno con el color del tema. -->
  <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Bg}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Todo boton sin estilo propio toma el del tema (antes salian grises, con el aspecto de Windows). -->
  <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}"/>

  <Style x:Key="RailIconButton" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
    <Setter Property="ToolTipService.Placement" Value="Right"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="90"/>
    <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="10"
                          ShadowDepth="0"
                          Opacity="0.18"
                          Color="#000000"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Brush.Inset}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
    <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
    <Setter Property="RowBackground" Value="{DynamicResource Brush.Inset}"/>
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Panel}"/>
    <Setter Property="AlternationCount" Value="2"/>
    <Setter Property="RowHeight" Value="32"/>
    <Setter Property="ColumnHeaderHeight" Value="32"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Brush.Header}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="{DynamicResource Brush.Inset}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="AlternationIndex" Value="1">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.RowHover}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.RowSelected}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="4,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbBorder"
                  Background="{DynamicResource Brush.HeaderBorder}"
                  CornerRadius="4"
                  Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource Brush.Inset}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.HeaderBorder}"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="12"/>
              <Setter Property="Width" Value="Auto"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Left"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.RowSelected}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="ToggleButton"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Foreground="{TemplateBinding Foreground}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Focusable="False"
                          ClickMode="Press">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="6">
                    <Grid>
                      <Path Data="M 0 0 L 4 4 L 8 0 Z"
                            Fill="{TemplateBinding Foreground}"
                            Width="8"
                            Height="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            
            <ContentPresenter x:Name="ContentSite"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              Margin="7,0,24,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"/>

            <Popup x:Name="Popup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Slide">
              <Border Background="{DynamicResource Brush.Panel}"
                      BorderBrush="{DynamicResource Brush.Accent}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="3"
                      Margin="0,4,0,0"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="280">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Campos de texto con esquinas redondeadas y foco del color del tema: antes, al enfocarlos,
       aparecia el borde azul de Windows, que chocaba con cualquier paleta. -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.SurfaceText}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.SurfaceText}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pestanas del tema (antes las grises de Windows): la activa se marca con el color del tema. -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Padding" Value="6"/>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Bd"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0,0,0,2"
                  CornerRadius="6,6,0,0"
                  Padding="16,7"
                  Margin="0,0,4,0">
            <ContentPresenter ContentSource="Header"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Casillas de verificacion del tema: antes eran las blancas de Windows. -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Box"
                    Width="17" Height="17"
                    CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1.5"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Path x:Name="Check"
                    Data="M 3.5 8.5 L 7 12 L 13.5 4.5"
                    Stroke="{DynamicResource Brush.Bg}"
                    StrokeThickness="2.2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Stretch="None"
                    Margin="-1,-1,0,0"
                    Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1"
                              Margin="8,0,0,0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>


<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+: el modo Entrenador usa el OCR integrado de Windows (Windows.Media.Ocr). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HandReader.Core\HandReader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\APH_Reference_100bb_6max.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Rangos borrador de contra limp, squeeze y heads-up (notacion de rangos, se editan sin tocar codigo). -->
    <None Update="Data\APH_Rangos_Borrador_6max.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Cortes del HUD calibrados con manos reales (APH.Calibration). -->
    <None Update="Data\population_baselines.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Equidad all-in de cada mano contra cada mano para el solver de all-in (la genera APH.Calibration con la opcion equidad). -->
    <None Update="Data\APH_Equidad_HU_169.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.74.0.4135" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="PDFsharp" Version="6.2.2" />
  </ItemGroup>
</Project>


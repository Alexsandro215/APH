<Window x:Class="Hud.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}"
        Height="780"
        Width="1060"
        MinHeight="620"
        MinWidth="860"
        WindowStartupLocation="CenterOwner">

  <!--
    Configuracion por secciones: a la izquierda el indice (Apariencia, Idioma, Informes, Respaldo) y a
    la derecha la seccion elegida, que entra con un fundido. Los temas se ven en una cuadricula con una
    vista previa de cada uno; el elegido lleva una marca.
  -->

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20,18"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="CardDesc" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,4,0,14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="SettingsCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style x:Key="GhostButton" BasedOn="{StaticResource Btn.Primary}" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Brush.Inset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    </Style>

    <!-- Indice de secciones -->
    <Style x:Key="SectionTab" TargetType="RadioButton">
      <Setter Property="GroupName" Value="SettingsSections"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Height="42">
              <Border x:Name="Hover" Background="{DynamicResource Brush.CardHover}" CornerRadius="9" Opacity="0"/>
              <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="14,0">
                <Grid>
                  <Border x:Name="Marker" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left"
                          Margin="-14,0,0,0" Background="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                      <ScaleTransform ScaleY="0"/>
                    </Border.RenderTransform>
                  </Border>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Width="22" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                    <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="1" Duration="0:0:0.26">
                        <DoubleAnimation.EasingFunction>
                          <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="0" Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Opcion elegible (animaciones, tamaño): tarjeta con un punto que se rellena al elegirla -->
    <Style x:Key="ChoiceChip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Border}"
                    Background="{DynamicResource Brush.Inset}" Padding="14,10" MinWidth="168">
              <DockPanel>
                <Border x:Name="Dot" DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="9" BorderThickness="2"
                        BorderBrush="{DynamicResource Brush.TextDim}" Margin="0,1,10,0" VerticalAlignment="Top">
                  <Border x:Name="DotFill" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Brush.Accent}"
                          Visibility="Collapsed"/>
                </Border>
                <ContentPresenter/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="DotFill" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChipTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="ChipDesc" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="190"/>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource Brush.AppShell}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Cabecera con la marca de APH -->
    <Border Grid.Row="0"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="22,18">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="50" Height="50" CornerRadius="12" Background="{DynamicResource Brush.Accent}"
                Margin="0,0,16,0">
          <Path Width="24" Height="27" Stretch="Uniform" Fill="{DynamicResource Brush.Bg}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M12,1 C12,1 2.5,8.2 2.5,13.6 C2.5,16.9 4.8,19.1 7.8,19.1 C9.4,19.1 10.7,18.4 11.3,17.3 C11.1,19.6 10,21.4 8.3,23 L15.7,23 C14,21.4 12.9,19.6 12.7,17.3 C13.3,18.4 14.6,19.1 16.2,19.1 C19.2,19.1 21.5,16.9 21.5,13.6 C21.5,8.2 12,1 12,1 Z"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Settings.Header}" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="{DynamicResource Settings.Subtitle}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Indice -->
      <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
        <StackPanel Margin="12,16,12,12">
          <RadioButton x:Name="TabAppearance" Style="{StaticResource SectionTab}" Tag="&#xE790;" IsChecked="True"
                       Checked="SectionTab_Checked" AutomationProperties.Name="{DynamicResource Settings.NavAppearance}">
            <TextBlock Text="{DynamicResource Settings.NavAppearance}"/>
          </RadioButton>
          <RadioButton x:Name="TabLanguage" Style="{StaticResource SectionTab}" Tag="&#xE774;"
                       Checked="SectionTab_Checked" AutomationProperties.Name="{DynamicResource Settings.NavLanguage}">
            <TextBlock Text="{DynamicResource Settings.NavLanguage}"/>
          </RadioButton>
          <RadioButton x:Name="TabRealTime" Style="{StaticResource SectionTab}" Tag="&#xE916;"
                       Checked="SectionTab_Checked" AutomationProperties.Name="{DynamicResource Settings.NavRealTime}">
            <TextBlock Text="{DynamicResource Settings.NavRealTime}"/>
          </RadioButton>
          <RadioButton x:Name="TabReports" Style="{StaticResource SectionTab}" Tag="&#xE8A5;"
                       Checked="SectionTab_Checked" AutomationProperties.Name="{DynamicResource Settings.NavReports}">
            <TextBlock Text="{DynamicResource Settings.NavReports}"/>
          </RadioButton>
          <RadioButton x:Name="TabSync" Style="{StaticResource SectionTab}" Tag="&#xE895;"
                       Checked="SectionTab_Checked" AutomationProperties.Name="{DynamicResource Settings.NavSync}">
            <TextBlock Text="{DynamicResource Settings.NavSync}"/>
          </RadioButton>
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="SectionScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid x:Name="SectionHost" Margin="24,20,24,8">

          <!-- ============ APARIENCIA ============ -->
          <StackPanel x:Name="SectionAppearance">
            <Border Style="{StaticResource SectionCard}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Settings.Themes}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{DynamicResource Settings.ThemesDesc}" Style="{StaticResource CardDesc}"/>
                <ItemsControl x:Name="PalettePreviewList" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="BtnPalette_Click" Tag="{Binding Key}" Margin="0,0,12,12" Cursor="Hand"
                              FocusVisualStyle="{x:Null}" ToolTip="{Binding Description}"
                              AutomationProperties.Name="{Binding Name}">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="Card" Width="196" CornerRadius="11" Background="{Binding CardBrush}"
                                    BorderBrush="{Binding BorderBrush}" BorderThickness="2" Padding="9"
                                    RenderTransformOrigin="0.5,0.5">
                              <Border.RenderTransform>
                                <ScaleTransform/>
                              </Border.RenderTransform>
                              <StackPanel>
                                <!-- Vista previa: fondo, barra lateral con su marca y una tarjeta con los colores -->
                                <Border Height="62" CornerRadius="7" Background="{Binding PreviewBrush}" ClipToBounds="True">
                                  <Grid>
                                    <Border Width="38" HorizontalAlignment="Left" Background="{Binding PanelBrush}" CornerRadius="7,0,0,7"/>
                                    <Border Width="20" Height="5" CornerRadius="2" Background="{Binding AccentBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,14,0,0"/>
                                    <Border Width="20" Height="5" CornerRadius="2" Background="{Binding TextDimBrush}" Opacity="0.55"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,25,0,0"/>
                                    <Border Width="20" Height="5" CornerRadius="2" Background="{Binding TextDimBrush}" Opacity="0.55"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,36,0,0"/>
                                    <Border Margin="48,10,10,10" CornerRadius="6" Background="{Binding CardBrush}"
                                            BorderBrush="{Binding BorderBrush}" BorderThickness="1">
                                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="14" Height="14" Fill="{Binding AccentBrush}" Margin="3,0"/>
                                        <Ellipse Width="14" Height="14" Fill="{Binding SecondaryBrush}" Margin="3,0"/>
                                        <Ellipse Width="14" Height="14" Fill="{Binding DangerBrush}" Margin="3,0"/>
                                        <Ellipse Width="14" Height="14" Fill="{Binding GoldBrush}" Margin="3,0"/>
                                      </StackPanel>
                                    </Border>
                                  </Grid>
                                </Border>
                                <DockPanel Margin="3,9,3,0">
                                  <Border x:Name="Check" DockPanel.Dock="Right" Width="20" Height="20" CornerRadius="10"
                                          Background="{Binding AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding BackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Border>
                                  <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{Binding TextBrush}"
                                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Description}" Foreground="{Binding TextDimBrush}" FontSize="11.5"
                                           Margin="3,3,3,2" Height="31" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{Binding AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{Binding AccentBrush}"/>
                                <Trigger.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.12"/>
                                      <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.12"/>
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.18"/>
                                      <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.ExitActions>
                              </Trigger>
                              <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{Binding AccentBrush}"/>
                              </Trigger>
                              <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.85"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Settings.Motion}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{DynamicResource Settings.MotionDesc}" Style="{StaticResource CardDesc}"/>
                <WrapPanel>
                  <RadioButton x:Name="MotionNormal" Style="{StaticResource ChoiceChip}" GroupName="Motion" Tag="Normal"
                               Click="Motion_Click" AutomationProperties.Name="{DynamicResource Settings.MotionNormal}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Settings.MotionNormal}" Style="{StaticResource ChipTitle}"/>
                      <TextBlock Text="{DynamicResource Settings.MotionNormalDesc}" Style="{StaticResource ChipDesc}"/>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="MotionReduced" Style="{StaticResource ChoiceChip}" GroupName="Motion" Tag="Reduced"
                               Click="Motion_Click" AutomationProperties.Name="{DynamicResource Settings.MotionReduced}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Settings.MotionReduced}" Style="{StaticResource ChipTitle}"/>
                      <TextBlock Text="{DynamicResource Settings.MotionReducedDesc}" Style="{StaticResource ChipDesc}"/>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="MotionOff" Style="{StaticResource ChoiceChip}" GroupName="Motion" Tag="Off"
                               Click="Motion_Click" AutomationProperties.Name="{DynamicResource Settings.MotionOff}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Settings.MotionOff}" Style="{StaticResource ChipTitle}"/>
                      <TextBlock Text="{DynamicResource Settings.MotionOffDesc}" Style="{StaticResource ChipDesc}"/>
                    </StackPanel>
                  </RadioButton>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Settings.UiScale}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{DynamicResource Settings.UiScaleDesc}" Style="{StaticResource CardDesc}"/>
                <WrapPanel x:Name="ScaleChoices">
                  <RadioButton x:Name="Scale90" Style="{StaticResource ChoiceChip}" GroupName="Scale" Tag="0.9"
                               Click="Scale_Click" AutomationProperties.Name="{DynamicResource Settings.UiScale90}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Settings.UiScale90}" Style="{StaticResource ChipTitle}"/>
                      <TextBlock Text="90 %" Style="{StaticResource ChipDesc}"/>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="Scale100" Style="{StaticResource ChoiceChip}" GroupName="Scale" Tag="1"
                               Click="Scale_Click" AutomationProperties.Name="{DynamicResource Settings.UiScale100}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Settings.UiScale100}" Style="{StaticResource ChipTitle}"/>
                      <TextBlock Text="100 %" Style="{StaticResource ChipDesc}"/>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="Scale110" Style="{StaticResource ChoiceChip}" GroupName="Scale" Tag="1.1"
                               Click="Scale_Click" AutomationProperties.Name="{DynamicResource Settings.UiScale110}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Settings.UiScale110}" Style="{StaticResource ChipTitle}"/>
                      <TextBlock Text="110 %" Style="{StaticResource ChipDesc}"/>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="Scale125" Style="{StaticResource ChoiceChip}" GroupName="Scale" Tag="1.25"
                               Click="Scale_Click" AutomationProperties.Name="{DynamicResource Settings.UiScale125}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Settings.UiScale125}" Style="{StaticResource ChipTitle}"/>
                      <TextBlock Text="125 %" Style="{StaticResource ChipDesc}"/>
                    </StackPanel>
                  </RadioButton>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ IDIOMA ============ -->
          <StackPanel x:Name="SectionLanguage" Visibility="Collapsed">
            <Border Style="{StaticResource SectionCard}">
              <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{DynamicResource Settings.LanguageDesc}" Style="{StaticResource CardDesc}"/>
                <TextBlock Text="{DynamicResource Settings.LanguageLabel}" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="LanguageCombo" Style="{StaticResource SettingsCombo}"
                          DisplayMemberPath="Display" SelectedValuePath="Key"
                          AutomationProperties.Name="{DynamicResource Settings.LanguageLabel}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ TIEMPO REAL ============ -->
          <StackPanel x:Name="SectionRealTime" Visibility="Collapsed">
            <Border Style="{StaticResource SectionCard}">
              <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource Settings.RtAsk}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{DynamicResource Settings.RtAskDesc}" Style="{StaticResource CardDesc}"/>
                <CheckBox x:Name="AskRealTimeCheck" Click="AskRealTimeCheck_Click"
                          AutomationProperties.Name="{DynamicResource Settings.RtAskCheck}">
                  <TextBlock Text="{DynamicResource Settings.RtAskCheck}" Foreground="{DynamicResource Brush.Text}"/>
                </CheckBox>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ INFORMES ============ -->
          <StackPanel x:Name="SectionReports" Visibility="Collapsed">
            <Border Style="{StaticResource SectionCard}">
              <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource Settings.ReportsFolder}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{DynamicResource Settings.ReportsFolderDesc}" Style="{StaticResource CardDesc}"/>
                <TextBlock Text="{DynamicResource Settings.ReportsFolderLabel}" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Height="36" Margin="10,0,0,0"
                          Click="BtnPickReportsFolder_Click" AutomationProperties.Name="{DynamicResource Settings.Search}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{DynamicResource Settings.Search}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <TextBox x:Name="ReportsFolderText"
                           MinHeight="36"
                           IsReadOnly="True"
                           Background="{DynamicResource Brush.Surface}"
                           Foreground="{DynamicResource Brush.SurfaceText}"
                           BorderThickness="0"
                           Padding="8,0"
                           VerticalContentAlignment="Center"
                           AutomationProperties.Name="{DynamicResource Settings.ReportsFolderLabel}"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
              <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource Settings.ReportSecurity}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{DynamicResource Settings.ReportSecurityDesc}" Style="{StaticResource CardDesc}"/>
                <CheckBox x:Name="ProtectReportsCheck"
                          Margin="0,0,0,12"
                          Click="ProtectReportsCheck_Click">
                  <TextBlock Text="{DynamicResource Settings.ProtectReports}"
                             Foreground="{DynamicResource Brush.Text}"/>
                </CheckBox>
                <TextBlock Text="{DynamicResource Settings.CurrentPassword}" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="OldPasswordBox" Height="32" Margin="0,0,0,10"
                             AutomationProperties.Name="{DynamicResource Settings.CurrentPassword}"/>
                <TextBlock Text="{DynamicResource Settings.NewPassword}" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="NewPasswordBox" Height="32" Margin="0,0,0,10"
                             AutomationProperties.Name="{DynamicResource Settings.NewPassword}"/>
                <TextBlock Text="{DynamicResource Settings.ConfirmNewPassword}" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="32" Margin="0,0,0,12"
                             AutomationProperties.Name="{DynamicResource Settings.ConfirmNewPassword}"/>
                <Button Content="{DynamicResource Settings.SavePassword}"
                        Style="{StaticResource Btn.Primary}"
                        MinWidth="170"
                        HorizontalAlignment="Left"
                        Click="BtnSaveReportPassword_Click"/>
                <TextBlock x:Name="ReportPasswordStatus"
                           Foreground="{DynamicResource Brush.TextDim}"
                           Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ RESPALDO ============ -->
          <StackPanel x:Name="SectionSync" Visibility="Collapsed">
            <Border Style="{StaticResource SectionCard}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Settings.Sync}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{DynamicResource Settings.SyncDesc}" Style="{StaticResource CardDesc}"/>
                <Border Background="{DynamicResource Brush.Inset}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                      <TextBlock Text="G" FontWeight="Black" FontSize="17" Foreground="{DynamicResource Brush.Accent}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Settings.ConnectedAccount}" FontWeight="Bold"/>
                      <TextBlock x:Name="GoogleAccountText"
                                 Text="{DynamicResource Settings.NoAccountDetected}"
                                 Foreground="{DynamicResource Brush.TextDim}"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap"
                                 MaxWidth="320"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <WrapPanel>
                  <Button x:Name="BtnGoogleUpload"
                          Style="{StaticResource GhostButton}"
                          MinHeight="62"
                          MinWidth="250"
                          Margin="0,0,12,0"
                          Click="BtnGoogleUpload_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.Accent}"/>
                      <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.UploadBackup}" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Settings.UploadBackupDesc}" Foreground="{DynamicResource Brush.TextDim}" FontSize="12"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnGoogleRestore"
                          Style="{StaticResource GhostButton}"
                          MinHeight="62"
                          MinWidth="250"
                          Click="BtnGoogleRestore_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.Accent}"/>
                      <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.RestoreDrive}" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Settings.RestoreDriveDesc}" Foreground="{DynamicResource Brush.TextDim}" FontSize="12"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <TextBlock x:Name="GoogleDriveStatus"
                           Foreground="{DynamicResource Brush.TextDim}"
                           Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- Pie: el aviso ocupa su propia columna y se parte en lineas; nunca se monta con los botones -->
    <Border Grid.Row="2"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0"
            Padding="22,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <DockPanel VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                     Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusText"
                     Text="{DynamicResource Settings.Status}"
                     Foreground="{DynamicResource Brush.TextDim}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"/>
        </DockPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="{DynamicResource Settings.Cancel}"
                  Style="{StaticResource GhostButton}"
                  MinWidth="110"
                  Margin="0,0,10,0"
                  Click="BtnCancel_Click"/>
          <Button Content="{DynamicResource Settings.Save}"
                  Style="{StaticResource Btn.Accent}"
                  MinWidth="150"
                  Click="BtnSave_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

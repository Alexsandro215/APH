<Window x:Class="Hud.App.Views.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="clr-namespace:Hud.App.Views.Charts"
        Title="{DynamicResource Main.Sessions}"
        Height="620"
        Width="980"
        MinHeight="480"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.AppShell}">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="RowBackground" Value="{DynamicResource Brush.Card}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="RowHeight" Value="34"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Brush.Header}"/>
      <Setter Property="Foreground" Value="{DynamicResource FgLight}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="190"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18"
            Margin="0,0,0,14">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="{DynamicResource Main.Sessions}"
                     FontSize="28"
                     FontWeight="Black"/>
          <TextBlock x:Name="FolderText"
                     Foreground="{DynamicResource Brush.TextDim}"
                     Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button Content="{DynamicResource Common.OpenFolder}"
                  Style="{StaticResource Btn.Primary}"
                  Width="120"
                  Margin="0,0,8,0"
                  Click="BtnOpenFolder_Click"/>
          <Button Content="{DynamicResource Common.Refresh}"
                  Style="{StaticResource Btn.Primary}"
                  Width="110"
                  Click="BtnRefresh_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="1"
               x:Name="StatusText"
               Foreground="{DynamicResource Brush.Accent}"
               Margin="4,0,0,10"/>

    <!-- Sesiones calculadas de los historiales: explicacion, grafica y tabla -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="2.2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
          <TextBlock Text="{DynamicResource Sessions.PlayedTitle}" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="{DynamicResource Sessions.PlayedExplain}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,0"/>
          <DockPanel Margin="0,6,0,0">
            <Button x:Name="GenerateReportButton" DockPanel.Dock="Left" Content="{DynamicResource Sessions.GenerateReport}"
                    AutomationProperties.Name="{DynamicResource Sessions.GenerateReport}"
                    Style="{StaticResource Btn.Accent}" Padding="14,6" Margin="0,0,12,0" Click="BtnGenerateReport_Click"/>
            <TextBlock Text="{DynamicResource Sessions.GenerateHint}" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="PlayedStatusText" Foreground="{DynamicResource Brush.Accent}" Margin="0,4,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,10,0">
          <TextBlock Text="{DynamicResource Sessions.ChartTitle}" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <charts:DivergingBarList x:Name="PlayedChart" LabelWidth="96"/>
          </ScrollViewer>
        </DockPanel>
        <DataGrid Grid.Row="1" Grid.Column="1" x:Name="PlayedGrid" RowHeight="28">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource Sessions.Col.Date}" Binding="{Binding DateLabel}" Width="92"/>
            <DataGridTextColumn Header="{DynamicResource Sessions.Col.Money}" Binding="{Binding MoneyLabel}" Width="72"/>
            <DataGridTextColumn Header="{DynamicResource Sessions.Col.Time}" Binding="{Binding TimeLabel}" Width="104"/>
            <DataGridTextColumn Header="{DynamicResource Common.Duration}" Binding="{Binding DurationLabel}" Width="78"/>
            <DataGridTextColumn Header="{DynamicResource Sessions.Col.Hands}" Binding="{Binding Hands}" Width="64"/>
            <DataGridTextColumn Header="{DynamicResource Main.TotalTables}" Binding="{Binding Tables}" Width="64"/>
            <DataGridTextColumn Header="{DynamicResource Sessions.Col.Result}" Binding="{Binding NetLabel}" Width="92"/>
            <DataGridTextColumn Header="{DynamicResource Sessions.Col.Winrate}" Binding="{Binding WinrateLabel}" Width="70"/>
            <DataGridTextColumn Header="{DynamicResource Sessions.Col.Adjusted}" Binding="{Binding AdjustedLabel}" Width="92"/>
            <DataGridTextColumn Header="{DynamicResource Sessions.Col.Best}" Binding="{Binding BestLabel}" Width="*"/>
            <DataGridTextColumn Header="{DynamicResource Sessions.Col.Worst}" Binding="{Binding WorstLabel}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <TextBlock Grid.Row="3" Text="{DynamicResource Sessions.ReportsTitle}" FontWeight="Bold" Margin="4,0,0,6"/>

    <DataGrid Grid.Row="4"
              x:Name="SessionsGrid"
              MouseDoubleClick="SessionsGrid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{DynamicResource Common.SessionNumber}" Binding="{Binding SessionNumber}" Width="70"/>
        <DataGridTextColumn Header="{DynamicResource Common.Start}" Binding="{Binding StartLabel}" Width="130"/>
        <DataGridTextColumn Header="{DynamicResource Common.Close}" Binding="{Binding CloseLabel}" Width="130"/>
        <DataGridTextColumn Header="{DynamicResource Sessions.Col.Money}" Binding="{Binding Money}" Width="72"/>
        <DataGridTextColumn Header="{DynamicResource Sessions.Col.Hands}" Binding="{Binding Hands}" Width="64"/>
        <DataGridTextColumn Header="{DynamicResource Main.TotalTables}" Binding="{Binding TableCount}" Width="64"/>
        <DataGridTextColumn Header="{DynamicResource Common.Duration}" Binding="{Binding DurationLabel}" Width="80"/>
        <DataGridTextColumn Header="{DynamicResource Sessions.Col.Result}" Binding="{Binding Result}" Width="190"/>
        <DataGridTextColumn Header="{DynamicResource Common.Hero}" Binding="{Binding Hero}" Width="130"/>
        <DataGridTextColumn Header="{DynamicResource Common.File}" Binding="{Binding FileName}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>

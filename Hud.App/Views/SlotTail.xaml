<UserControl x:Class="Hud.App.Views.SlotTail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Hud.App.Views">
  <UserControl.Resources>
    <views:StatToBrushConverter x:Key="StatToBrush"/>

    <SolidColorBrush x:Key="HudBlueDark"
                     Color="#0D1B2A"/>
    <!-- pasivo -->
    <SolidColorBrush x:Key="HudBlue"
                     Color="#1B263B"/>
    <SolidColorBrush x:Key="HudGreenSoft"
                     Color="#7AE582"/>
    <!-- sano -->
    <SolidColorBrush x:Key="HudYellow"
                     Color="#F2E863"/>
    <SolidColorBrush x:Key="HudOrange"
                     Color="#F4A261"/>
    <SolidColorBrush x:Key="HudRedSoft"
                     Color="#FF7A7A"/>
    <SolidColorBrush x:Key="HudRed"
                     Color="#E63946"/>
    <!-- agresivo -->

    <!-- CONVERTERS -->
    <views:LastHandsToStringConverter x:Key="Last9Conv"/>
    <views:EqualsToBoolConverter x:Key="Eq"/>
    <views:PlayerStatsToolTipConverter x:Key="PlayerToolTip"/>
    <views:PlayerHistoryRowBrushConverter x:Key="PlayerHistoryRowBrush"/>
    <views:PlayerHistoryTextBrushConverter x:Key="PlayerHistoryTextBrush"/>

    <!-- PALETA: viene del tema global (Styles/PokerTheme.xaml + ThemePaletteManager) -->

    <!-- ESTILOS BASE -->
    <Style TargetType="TextBlock">
      <Setter Property="FontSize"
              Value="12"/>
      <Setter Property="Foreground"
              Value="{DynamicResource FgLight}"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="FontSize"
              Value="12"/>
      <Setter Property="Background"
              Value="{DynamicResource BtnBg}"/>
      <Setter Property="Foreground"
              Value="{StaticResource BtnFg}"/>
      <Setter Property="BorderBrush"
              Value="{DynamicResource BorderDark}"/>
      <Setter Property="BorderThickness"
              Value="1"/>
      <Setter Property="Padding"
              Value="6,2"/>
      <Setter Property="Cursor"
              Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver"
                 Value="True">
          <Setter Property="Background"
                  Value="{DynamicResource BtnBgHover}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="FontSize"
              Value="12"/>
      <Setter Property="RowHeaderWidth"
              Value="0"/>
      <Setter Property="RowHeight"
              Value="26"/>
      <Setter Property="HeadersVisibility"
              Value="All"/>
      <Setter Property="GridLinesVisibility"
              Value="None"/>
      <Setter Property="Background"
              Value="{DynamicResource BgDark}"/>
      <Setter Property="RowBackground"
              Value="{DynamicResource BgDark}"/>
      <Setter Property="AlternatingRowBackground"
              Value="{DynamicResource BgDark}"/>
      <Setter Property="BorderBrush"
              Value="{DynamicResource BorderDark}"/>
      <Setter Property="Foreground"
              Value="{DynamicResource FgLight}"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background"
              Value="{DynamicResource PanelDark}"/>
      <Setter Property="Foreground"
              Value="{DynamicResource FgLight}"/>
      <Setter Property="BorderBrush"
              Value="{DynamicResource BorderDark}"/>
      <Setter Property="FontWeight"
              Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment"
              Value="Center"/>
      <Setter Property="Padding"
              Value="4,2"/>
      <Setter Property="FontSize"
              Value="12"/>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Background"
              Value="{DynamicResource BgDark}"/>
      <Setter Property="Foreground"
              Value="{DynamicResource FgLight}"/>
      <Setter Property="BorderBrush"
              Value="{DynamicResource BorderDark}"/>
      <Setter Property="BorderThickness"
              Value="0,0,0,1"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Background"
              Value="{DynamicResource BgDark}"/>
      <Setter Property="Foreground"
              Value="{DynamicResource FgLight}"/>
      <Setter Property="BorderBrush"
              Value="{DynamicResource BorderDark}"/>
      <Setter Property="BorderThickness"
              Value="0,0,0,1"/>
      <Setter Property="Padding"
              Value="6,2"/>
    </Style>

  </UserControl.Resources>

  <Border Background="{DynamicResource BgDark}"
          BorderBrush="{DynamicResource BorderDark}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- BARRA SUPERIOR -->
      <StackPanel Orientation="Horizontal"
                  Grid.Row="0"
                  Grid.ColumnSpan="2"
                  VerticalAlignment="Center">
        <TextBlock x:Name="PathText"
                   Text="{DynamicResource Common.TablePlaceholder}"
                   Foreground="{DynamicResource FgAccent}"
                   Margin="0,0,8,0"/>
        <Button x:Name="BtnPick"
                Content="+"
                Width="26"
                Height="26"
                Margin="0,0,4,0"
                Click="Pick_Click"/>
        <Button x:Name="BtnStart"
                Content="&#x25B6;"
                Width="26"
                Height="26"
                Margin="0,0,4,0"
                Click="Start_Click"/>
        <Button x:Name="BtnStop"
                Content="&#x25A0;"
                Width="26"
                Height="26"
                Click="Stop_Click"/>
        <!-- Farol por mesa (solo dinero ficticio): contra quien se deja farolear, el consejo puede apostar de farol -->
        <ToggleButton x:Name="BtnBluff"
                      Content="{DynamicResource RT.Bluff}"
                      AutomationProperties.Name="{DynamicResource RT.Bluff}"
                      ToolTip="{DynamicResource RT.BluffTip}"
                      Height="26"
                      Margin="6,0,0,0"
                      Padding="8,0"
                      FontSize="12"
                      Cursor="Hand"
                      IsEnabled="False"
                      Click="Bluff_Click">
          <ToggleButton.Style>
            <Style TargetType="ToggleButton">
              <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource FgLight}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BorderDark}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Background" Value="#3A6EA5"/>
                  <Setter Property="Foreground" Value="White"/>
                  <Setter Property="BorderBrush" Value="#78C8FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ToggleButton.Style>
        </ToggleButton>

            <TextBlock Text="{DynamicResource Common.Lines}"
                   Foreground="{DynamicResource FgDim}"
                   Margin="12,0,4,0"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="Lines"
                   Text="0"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Common.Last}"
                   Foreground="{DynamicResource FgDim}"
                   Margin="12,0,4,0"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="Last"
                   Text="&#x2014;"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>

            <TextBlock Text="{DynamicResource Common.Hero}"
                   Foreground="{DynamicResource FgDim}"
                   Margin="12,0,4,0"
                   VerticalAlignment="Center"/>
        <TextBox Width="130"
                 Height="24"
                 VerticalAlignment="Center"
                 Text="{Binding HeroName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <ItemsControl x:Name="LastLines"
                      Margin="12,0,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Foreground="{DynamicResource FgDim}"
                         FontSize="11"
                         Text="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- TABLA -->
      <DataGrid Grid.Row="1"
                Grid.ColumnSpan="2"
                ItemsSource="{Binding Players}"
                AutoGenerateColumns="False"
                SelectionUnit="FullRow"
                EnableRowVirtualization="True"
                HeadersVisibility="All"
                PreviewMouseLeftButtonUp="PlayersGrid_PreviewMouseLeftButtonUp">

        <!-- RowStyle: sombreado integral + barra lateral -->
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow"
                 BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background"
                    Value="{Binding Name, Converter={StaticResource PlayerHistoryRowBrush}}"/>
            <Setter Property="Foreground"
                    Value="{Binding Name, Converter={StaticResource PlayerHistoryTextBrush}}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                  <Grid>
                    <Border x:Name="HeroAccent"
                            Width="3"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource HeroRowAccent}"
                            Opacity="0"/>
                    <Border x:Name="RowBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                      <SelectiveScrollingGrid>
                        <SelectiveScrollingGrid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </SelectiveScrollingGrid.ColumnDefinitions>
                        <SelectiveScrollingGrid.RowDefinitions>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="Auto"/>
                        </SelectiveScrollingGrid.RowDefinitions>
                        <DataGridCellsPresenter Grid.Column="1"/>
                        <DataGridDetailsPresenter Grid.Column="1"
                                                  Grid.Row="1"
                                                  Visibility="{TemplateBinding DetailsVisibility}"/>
                      </SelectiveScrollingGrid>
                    </Border>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <!-- h?roe -->
                    <DataTrigger Value="True">
                      <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource Eq}">
                          <Binding Path="Name"/>
                          <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                                   Path="DataContext.HeroName"/>
                        </MultiBinding>
                      </DataTrigger.Binding>
                      <Setter TargetName="RowBg"
                              Property="Background"
                              Value="{DynamicResource HeroRow}"/>
                      <Setter TargetName="HeroAccent"
                              Property="Opacity"
                              Value="1"/>
                      <Setter Property="FontWeight"
                              Value="Bold"/>
                    </DataTrigger>

                    <!-- seleccionado -->
                    <Trigger Property="IsSelected"
                             Value="True">
                      <Setter TargetName="RowBg"
                              Property="Background"
                              Value="{DynamicResource HeroRowSelected}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="ToolTip"
                    Value="{Binding Converter={StaticResource PlayerToolTip}}"/>
          </Style>
        </DataGrid.RowStyle>

        <!-- CellStyle: refuerzo para que ninguna celda sobrescriba el fondo -->
        <DataGrid.CellStyle>
          <Style TargetType="DataGridCell"
                 BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Background"
                    Value="{Binding Name, Converter={StaticResource PlayerHistoryRowBrush}}"/>
            <Setter Property="Foreground"
                    Value="{Binding Name, Converter={StaticResource PlayerHistoryTextBrush}}"/>
            <Setter Property="ToolTip"
                    Value="{Binding Converter={StaticResource PlayerToolTip}}"/>
            <Style.Triggers>
              <DataTrigger Value="True">
                <DataTrigger.Binding>
                  <MultiBinding Converter="{StaticResource Eq}">
                    <Binding Path="DataContext.Name"
                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                    <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                             Path="DataContext.HeroName"/>
                  </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Background"
                        Value="{DynamicResource HeroRow}"/>
                <Setter Property="FontWeight"
                        Value="Bold"/>
              </DataTrigger>

              <Trigger Property="IsSelected"
                       Value="True">
                <Setter Property="Background"
                        Value="{DynamicResource HeroRowSelected}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.CellStyle>

        <!-- Columnas -->
        <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Grid.Player}"
                              Binding="{Binding Name}"
                              Width="150"/>
          <!-- Nota y color del jugador (se ven en su cuadro del HUD de la mesa) -->
          <DataGridTemplateColumn Header="{DynamicResource Notes.Column}" Width="58">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{DynamicResource Notes.Column}" Padding="6,1" Margin="1" FontSize="11"
                        Click="NoteButton_Click" Tag="{Binding Name}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{DynamicResource Grid.Hands}"
                              Binding="{Binding HandsReceived}"
                              Width="64"/>

          <!-- Preflop -->
          <DataGridTemplateColumn Header="VPIP%"
                                  Width="64">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding VPIPPct, StringFormat={}{0:0.#}%}"
                           TextAlignment="Center"
                           Padding="2">
                  <TextBlock.Background>
                    <MultiBinding Converter="{StaticResource StatToBrush}">
                      <Binding Path="VPIPPct"/>
                      <!-- valor -->
                      <Binding Path="HandsReceived"/>
                      <!-- manos (gating) -->
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                               Path="DataContext.Stake"/>
                      <!-- stake -->
                      <Binding Source="VPIP"/>
                      <!-- clave preset -->
                    </MultiBinding>
                  </TextBlock.Background>
                  <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="ink">
                      <Binding Path="VPIPPct"/>
                      <!-- valor -->
                      <Binding Path="HandsReceived"/>
                      <!-- manos (gating) -->
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <!-- stake -->
                      <Binding Source="VPIP"/>
                      <!-- clave preset -->
                    </MultiBinding>
                  </TextBlock.Foreground>
                  <TextBlock.ToolTip>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="tip">
                      <Binding Path="VPIPPct"/>
                      <!-- valor -->
                      <Binding Path="HandsReceived"/>
                      <!-- manos (gating) -->
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <!-- stake -->
                      <Binding Source="VPIP"/>
                      <!-- clave preset -->
                    </MultiBinding>
                  </TextBlock.ToolTip>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="PFR%"
                                  Width="60">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding PFRPct, StringFormat={}{0:0.#}%}"
                           TextAlignment="Center"
                           Padding="2">
                  <TextBlock.Background>
                    <MultiBinding Converter="{StaticResource StatToBrush}">
                      <Binding Path="PFRPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                               Path="DataContext.Stake"/>
                      <Binding Source="PFR"/>
                    </MultiBinding>
                  </TextBlock.Background>
                  <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="ink">
                      <Binding Path="PFRPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="PFR"/>
                    </MultiBinding>
                  </TextBlock.Foreground>
                  <TextBlock.ToolTip>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="tip">
                      <Binding Path="PFRPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="PFR"/>
                    </MultiBinding>
                  </TextBlock.ToolTip>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="3Bet%"
                                  Width="64">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ThreeBetPct, StringFormat={}{0:0.#}%}"
                           TextAlignment="Center"
                           Padding="2">
                  <TextBlock.Background>
                    <MultiBinding Converter="{StaticResource StatToBrush}">
                      <Binding Path="ThreeBetPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                               Path="DataContext.Stake"/>
                      <Binding Source="THREEBET"/>
                    </MultiBinding>
                  </TextBlock.Background>
                  <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="ink">
                      <Binding Path="ThreeBetPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="THREEBET"/>
                    </MultiBinding>
                  </TextBlock.Foreground>
                  <TextBlock.ToolTip>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="tip">
                      <Binding Path="ThreeBetPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="THREEBET"/>
                    </MultiBinding>
                  </TextBlock.ToolTip>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Postflop / Agg -->
          <DataGridTemplateColumn Header="AF"
                                  Width="52">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding AF, StringFormat={}{0:0.#}}"
                           TextAlignment="Center"
                           Padding="2">
                  <TextBlock.Background>
                    <MultiBinding Converter="{StaticResource StatToBrush}">
                      <Binding Path="AF"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                               Path="DataContext.Stake"/>
                      <Binding Source="AF"/>
                    </MultiBinding>
                  </TextBlock.Background>
                  <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="ink">
                      <Binding Path="AF"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="AF"/>
                    </MultiBinding>
                  </TextBlock.Foreground>
                  <TextBlock.ToolTip>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="tip">
                      <Binding Path="AF"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="AF"/>
                    </MultiBinding>
                  </TextBlock.ToolTip>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="AFq%"
              Width="60">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding AFqPct, StringFormat={}{0:0.#}%}"
                    TextAlignment="Center"
                    Padding="2">
                  <TextBlock.Background>
                    <MultiBinding Converter="{StaticResource StatToBrush}">
                      <Binding Path="AFqPct"/>
                      <!-- valor -->
                      <Binding Path="HandsReceived"/>
                      <!-- manos -->
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                          Path="DataContext.Stake"/>
                      <Binding Source="AFQ"/>
                      <!-- clave -->
                    </MultiBinding>
                  </TextBlock.Background>
                  <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="ink">
                      <Binding Path="AFqPct"/>
                      <!-- valor -->
                      <Binding Path="HandsReceived"/>
                      <!-- manos -->
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="AFQ"/>
                      <!-- clave -->
                    </MultiBinding>
                  </TextBlock.Foreground>
                  <TextBlock.ToolTip>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="tip">
                      <Binding Path="AFqPct"/>
                      <!-- valor -->
                      <Binding Path="HandsReceived"/>
                      <!-- manos -->
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="AFQ"/>
                      <!-- clave -->
                    </MultiBinding>
                  </TextBlock.ToolTip>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>


          <!-- CBet -->
          <DataGridTemplateColumn Header="CBet%"
              Width="64">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding CBetFlopPct, StringFormat={}{0:0.#}%}"
                    TextAlignment="Center"
                    Padding="2">
                  <TextBlock.Background>
                    <MultiBinding Converter="{StaticResource StatToBrush}">
                      <Binding Path="CBetFlopPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                          Path="DataContext.Stake"/>
                      <Binding Source="CBF"/>
                      <!-- clave -->
                      <!-- Si alg?n d?a expones "CBetOppFlop" como oportunidades, pasalo como 5? binding -->
                    </MultiBinding>
                  </TextBlock.Background>
                  <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="ink">
                      <Binding Path="CBetFlopPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="CBF"/>
                      <!-- clave -->
                      <!-- Si alg?n d?a expones "CBetOppFlop" como oportunidades, pasalo como 5? binding -->
                    </MultiBinding>
                  </TextBlock.Foreground>
                  <TextBlock.ToolTip>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="tip">
                      <Binding Path="CBetFlopPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="CBF"/>
                      <!-- clave -->
                      <!-- Si alg?n d?a expones "CBetOppFlop" como oportunidades, pasalo como 5? binding -->
                    </MultiBinding>
                  </TextBlock.ToolTip>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- REEMPLAZA ESTA -->
          <!-- <DataGridTextColumn Header="FvCBet%" Binding="{Binding FoldVsCBetFlopPct, StringFormat={}{0:0.#}%}" Width="70"/> -->

          <!-- POR ESTA -->
          <DataGridTemplateColumn Header="FvCBet%"
                                  Width="70">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding FoldVsCBetFlopPct, StringFormat={}{0:0.#}%}"
                           TextAlignment="Center"
                           Padding="2">
                  <TextBlock.Background>
                    <MultiBinding Converter="{StaticResource StatToBrush}">
                      <Binding Path="FoldVsCBetFlopPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                               Path="DataContext.Stake"/>
                      <Binding Source="FVCBF"/>
                      <!-- esta clave ya est? marcada Invert=true en los presets -->
                    </MultiBinding>
                  </TextBlock.Background>
                  <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="ink">
                      <Binding Path="FoldVsCBetFlopPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="FVCBF"/>
                      <!-- esta clave ya est? marcada Invert=true en los presets -->
                    </MultiBinding>
                  </TextBlock.Foreground>
                  <TextBlock.ToolTip>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="tip">
                      <Binding Path="FoldVsCBetFlopPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="FVCBF"/>
                      <!-- esta clave ya est? marcada Invert=true en los presets -->
                    </MultiBinding>
                  </TextBlock.ToolTip>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Showdown -->
          <DataGridTemplateColumn Header="WTSD%"
              Width="60">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding WTSDPct, StringFormat={}{0:0.#}%}"
                    TextAlignment="Center"
                    Padding="2">
                  <TextBlock.Background>
                    <MultiBinding Converter="{StaticResource StatToBrush}">
                      <Binding Path="WTSDPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                          Path="DataContext.Stake"/>
                      <Binding Source="WTSD"/>
                    </MultiBinding>
                  </TextBlock.Background>
                  <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="ink">
                      <Binding Path="WTSDPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="WTSD"/>
                    </MultiBinding>
                  </TextBlock.Foreground>
                  <TextBlock.ToolTip>
                    <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="tip">
                      <Binding Path="WTSDPct"/>
                      <Binding Path="HandsReceived"/>
                      <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"
                      Path="DataContext.Stake"/>
                      <Binding Source="WTSD"/>
                    </MultiBinding>
                  </TextBlock.ToolTip>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="W$SD%"
              Width="60">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding WSDPct, StringFormat={}{0:0.#}%}"
                    TextAlignment="Center"
                    Padding="2">

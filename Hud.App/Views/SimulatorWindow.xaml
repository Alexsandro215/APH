<Window x:Class="Hud.App.Views.SimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulador"
        Width="1400" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="PanelCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="16" Padding="{TemplateBinding Padding}"
                    Background="{DynamicResource Brush.Inset}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Interruptor de encender y apagar (la explicacion tecnica) -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Padding="2">
              <StackPanel Orientation="Horizontal">
                <Grid Width="38" Height="22" VerticalAlignment="Center">
                  <Border x:Name="Track" CornerRadius="11" BorderThickness="1"
                          Background="{DynamicResource Brush.Inset}" BorderBrush="{DynamicResource Brush.Border}"/>
                  <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left"
                           VerticalAlignment="Center" Fill="{DynamicResource Brush.TextDim}"/>
                </Grid>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ListItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="8" Padding="10,7"
                    Background="{DynamicResource Brush.Inset}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid" Margin="16" Focusable="True" KeyDown="RootGrid_KeyDown" FocusVisualStyle="{x:Null}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Cabecera (dentro de APH la muestra la barra superior) -->
    <Border x:Name="HeaderCard" Style="{StaticResource PanelCard}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="SummaryText" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="380"/>
      </Grid.ColumnDefinitions>

      <!-- Mesa, rubro y rival -->
      <Border Style="{StaticResource PanelCard}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TableLabel" Style="{StaticResource FieldLabel}"/>
            <WrapPanel x:Name="TablePanel"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="SessionText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,8"/>
            <Button x:Name="NewHandButton" Padding="12,9" Style="{DynamicResource Btn.Accent}" Click="NewHandButton_Click"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" x:Name="RivalSection" Margin="0,10,0,0">
            <TextBlock x:Name="RivalLabel" Style="{StaticResource FieldLabel}"/>
            <WrapPanel x:Name="RivalPanel"/>
            <TextBlock x:Name="RivalText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.TextDim}"/>
          </StackPanel>
          <DockPanel Margin="0,10,0,0">
            <TextBlock x:Name="DrillLabel" DockPanel.Dock="Top" Style="{StaticResource FieldLabel}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="DrillList"/>
            </ScrollViewer>
          </DockPanel>
        </DockPanel>
      </Border>

      <!-- La mesa y los botones -->
      <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="12,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <TextBlock x:Name="ResultText" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="DrillTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,8,0,0">
            <Canvas x:Name="TableCanvas" Width="940" Height="560"/>
          </Viewbox>
          <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <WrapPanel x:Name="ActionPanel" MinHeight="48"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Jugada y revision -->
      <Border Grid.Column="2" Style="{StaticResource PanelCard}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <ToggleButton x:Name="TechToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock x:Name="RightTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <StackPanel x:Name="RangePanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock x:Name="RangeTitle" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,6"/>
            <Viewbox Stretch="Uniform" MaxHeight="300">
              <UniformGrid x:Name="RangeGrid" Rows="13" Columns="13" Width="390" Height="390"/>
            </Viewbox>
          </StackPanel>
          <ScrollViewer x:Name="RightScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RightList"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

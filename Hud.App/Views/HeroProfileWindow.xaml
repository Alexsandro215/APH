<Window x:Class="Hud.App.Views.HeroProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="clr-namespace:Hud.App.Views.Charts"
        xmlns:views="clr-namespace:Hud.App.Views"
        Title="{DynamicResource Common.HeroProfileTitle}"
        Height="860"
        Width="1480"
        MinHeight="720"
        MinWidth="1180"
        Background="{DynamicResource Brush.AppShell}"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <views:StatToBrushConverter x:Key="StatToBrush"/>
    <views:StatTextBrushConverter x:Key="StatTextBrush"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="PanelBorder" TargetType="Border" BasedOn="{StaticResource ProjectPanelBorder}"/>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource Brush.Inset}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="RowBackground" Value="{DynamicResource Brush.Inset}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Card}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="ColumnHeaderHeight" Value="28"/>
      <Setter Property="RowHeight" Value="24"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Brush.Header}"/>
      <Setter Property="Foreground" Value="{DynamicResource FgLight}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="TextElement.FontSize" Value="12"/>
      <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource FgLight}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="NoWrapCellText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12" Padding="18">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Width="38"
                Height="38"
                Margin="12,0,0,0"
                Padding="0"
                FontSize="20"
                FontWeight="Bold"
                Foreground="{DynamicResource Brush.SurfaceText}"
                Content="?"
                Click="BtnDictionary_Click"
                 ToolTip="{DynamicResource Common.OpenDictionary}"/>
        <Border Width="58" Height="58" CornerRadius="12" Background="{DynamicResource Brush.Inset}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,16,0">
          <Viewbox Stretch="Uniform">
            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"/>
          </Viewbox>
        </Border>
        <StackPanel>
          <TextBlock Text="{Binding HeroTitle}" FontSize="26" FontWeight="Bold"/>
          <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <UniformGrid Columns="5">
          <StackPanel Margin="8">
            <TextBlock Text="{DynamicResource Common.Hands}" Foreground="{DynamicResource Brush.TextDim}"/>
            <TextBlock Text="{Binding HandsLabel}" FontSize="22" FontWeight="Bold"/>
          </StackPanel>
          <StackPanel Margin="8">
            <TextBlock Text="{DynamicResource Common.TotalResult}" Foreground="{DynamicResource Brush.TextDim}"/>
            <TextBlock Text="{Binding TotalBbLabel}" FontSize="22" FontWeight="Bold" Foreground="{Binding TotalBbBrush}"/>
          </StackPanel>
          <StackPanel Margin="8">
            <TextBlock Text="BB/100" Foreground="{DynamicResource Brush.TextDim}"/>
            <TextBlock Text="{Binding BbPer100Label}" FontSize="22" FontWeight="Bold" Foreground="{Binding TotalBbBrush}"/>
          </StackPanel>
          <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource Common.BestPosition}" Foreground="{DynamicResource Brush.TextDim}"/>
            <TextBlock Text="{Binding BestPositionLabel}" FontSize="22" FontWeight="Bold"/>
          </StackPanel>
          <StackPanel Margin="8">
            <TextBlock Text="{DynamicResource Common.WorstPosition}" Foreground="{DynamicResource Brush.TextDim}"/>
            <TextBlock Text="{Binding WorstPositionLabel}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Negative}"/>
          </StackPanel>
        </UniformGrid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tags}" Margin="4,10,4,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{Binding Background}"
                      BorderBrush="{Binding Border}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="8,4"
                      Margin="4"
                      ToolTip="{Binding Description}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ContentControl Content="{Binding CardChips}"
                                  ContentTemplate="{StaticResource CardChipListTemplate}"
                                  Margin="0,0,5,0"/>
                  <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
      <StackPanel>
      <TextBlock Text="{DynamicResource Main.GlobalStats}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <TextBlock Text="{DynamicResource HeroStats.Hint}" Foreground="{DynamicResource Brush.TextDim}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <ItemsControl ItemsSource="{Binding StatMetrics}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="10"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="1" ToolTip="{Binding Help}" Background="Transparent">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="30"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="{Binding Label}" Background="{DynamicResource Brush.Header}" Foreground="{DynamicResource FgLight}" FontWeight="SemiBold" TextAlignment="Center" Padding="4,2"/>
                  <TextBlock Grid.Row="1" Text="{Binding DisplayValue}" TextAlignment="Center" FontWeight="SemiBold" Padding="4,6">
                    <TextBlock.Background>
                      <MultiBinding Converter="{StaticResource StatToBrush}">
                        <Binding Path="Value"/>
                        <Binding Path="Hands"/>
                        <Binding Path="Stake"/>
                        <Binding Path="Key"/>
                      </MultiBinding>
                    </TextBlock.Background>
                    <TextBlock.Foreground>
                      <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="ink">
                        <Binding Path="Value"/>
                        <Binding Path="Hands"/>
                        <Binding Path="Stake"/>
                        <Binding Path="Key"/>
                      </MultiBinding>
                    </TextBlock.Foreground>
                    <TextBlock.ToolTip>
                      <MultiBinding Converter="{StaticResource StatToBrush}" ConverterParameter="tip">
                        <Binding Path="Value"/>
                        <Binding Path="Hands"/>
                        <Binding Path="Stake"/>
                        <Binding Path="Key"/>
                      </MultiBinding>
                    </TextBlock.ToolTip>
                  </TextBlock>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <views:StatLegendStrip HorizontalAlignment="Center" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="3">
      <TabItem Header="{DynamicResource HeroTab.Summary}">
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="1.05*"/>
            <RowDefinition Height="1*"/>
          </Grid.RowDefinitions>

          <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,8">
            <DockPanel>
              <TextBlock Text="{DynamicResource Common.PositionProfit}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0,0,0,8"/>
              <DataGrid ItemsSource="{Binding PositionRows}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="50" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTextColumn Header="{DynamicResource Common.Hands}" Binding="{Binding Hands}" Width="58" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTextColumn Header="VPIP" Binding="{Binding VpipLabel}" Width="58" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTextColumn Header="PFR" Binding="{Binding PfrLabel}" Width="56" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTextColumn Header="3Bet" Binding="{Binding ThreeBetLabel}" Width="56" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTemplateColumn Header="BB" Width="76">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding TotalBbTrendIcon}" Foreground="{Binding TotalBbTrendBrush}" FontWeight="Bold" Margin="0,0,4,0"/>
                          <TextBlock Text="{Binding TotalBbLabel}" Style="{StaticResource NoWrapCellText}"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="BB/100" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding BbPer100TrendIcon}" Foreground="{Binding BbPer100TrendBrush}" FontWeight="Bold" Margin="0,0,4,0"/>
                          <TextBlock Text="{Binding BbPer100Label}" Style="{StaticResource NoWrapCellText}"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{DynamicResource Common.WorstHand}" Binding="{Binding WorstHand}" Width="*" ElementStyle="{StaticResource NoWrapCellText}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="8,0,8,8">
            <DockPanel>
              <TextBlock Text="{DynamicResource Common.TopCombos}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0,0,0,8"/>
              <DataGrid ItemsSource="{Binding TopCombos}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Common.Cards}" Binding="{Binding Combo}" Width="58" ElementStyle="{StaticResource NoWrapCellText}"/>
                <DataGridTextColumn Header="{DynamicResource Common.Times}" Binding="{Binding Count}" Width="52" ElementStyle="{StaticResource NoWrapCellText}"/>
                <DataGridTextColumn Header="{DynamicResource Common.Usage}" Binding="{Binding UsageLabel}" Width="58" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTextColumn Header="VPIP" Binding="{Binding VpipLabel}" Width="58" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTextColumn Header="PFR" Binding="{Binding PfrLabel}" Width="56" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTemplateColumn Header="{DynamicResource Common.Average}" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding AverageBbTrendIcon}" Foreground="{Binding AverageBbTrendBrush}" FontWeight="Bold" Margin="0,0,4,0"/>
                          <TextBlock Text="{Binding AverageBbLabel}" Style="{StaticResource NoWrapCellText}"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="BB" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding TotalBbTrendIcon}" Foreground="{Binding TotalBbTrendBrush}" FontWeight="Bold" Margin="0,0,4,0"/>
                          <TextBlock Text="{Binding TotalBbLabel}" Style="{StaticResource NoWrapCellText}"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Pos" Binding="{Binding CommonPosition}" Width="*" ElementStyle="{StaticResource NoWrapCellText}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="8,0,0,8">
            <DockPanel>
              <TextBlock Text="{DynamicResource Common.EvByAction}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0,0,0,8"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <charts:DivergingBarList Items="{Binding ActionBars}" LabelWidth="96"/>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,8,8,0">
            <DockPanel>
              <TextBlock Text="{DynamicResource Common.BestHands}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0,0,0,8"/>
              <DataGrid ItemsSource="{Binding BestHands}" MouseLeftButtonUp="HandGrid_MouseLeftButtonUp">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding HandNumber}" Width="44" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTemplateColumn Header="Cartas" Width="62">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ContentControl Content="{Binding CardChips}" ContentTemplate="{StaticResource CardChipListTemplate}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Combo" Binding="{Binding Combo}" Width="58" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="50" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTextColumn Header="{DynamicResource Common.Action}" Binding="{Binding Action}" Width="70" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTemplateColumn Header="BB" Width="74">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding NetBbTrendIcon}" Foreground="{Binding NetBbTrendBrush}" FontWeight="Bold" Margin="0,0,4,0"/>
                          <TextBlock Text="{Binding NetBbLabel}" Style="{StaticResource NoWrapCellText}"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{DynamicResource Grid.Table}" Binding="{Binding TableName}" Width="*" ElementStyle="{StaticResource NoWrapCellText}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="8,8,8,0">
            <DockPanel>
              <TextBlock Text="{DynamicResource Common.WorstHands}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0,0,0,8"/>
              <DataGrid ItemsSource="{Binding WorstHands}" MouseLeftButtonUp="HandGrid_MouseLeftButtonUp">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding HandNumber}" Width="44" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTemplateColumn Header="Cartas" Width="62">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ContentControl Content="{Binding CardChips}" ContentTemplate="{StaticResource CardChipListTemplate}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Combo" Binding="{Binding Combo}" Width="58" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="50" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTextColumn Header="{DynamicResource Common.Action}" Binding="{Binding Action}" Width="70" ElementStyle="{StaticResource NoWrapCellText}"/>
                  <DataGridTemplateColumn Header="BB" Width="74">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding NetBbTrendIcon}" Foreground="{Binding NetBbTrendBrush}" FontWeight="Bold" Margin="0,0,4,0"/>
                          <TextBlock Text="{Binding NetBbLabel}" Style="{StaticResource NoWrapCellText}"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{DynamicResource Grid.Table}" Binding="{Binding TableName}" Width="*" ElementStyle="{StaticResource NoWrapCellText}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="8,8,0,0">
            <DockPanel>
              <TextBlock Text="{DynamicResource Common.QuickRead}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Brush.Inset}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                      <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Text}"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="{DynamicResource HeroTab.HandTypes}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,10,0,0">
          <!-- Primero que es cada numero, luego la conclusion y despues el detalle: grafica y tabla
               con altura fija para que se vean los 13 tipos de mano. -->
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="440"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.6*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.ColumnSpan="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="{DynamicResource HandTypes.Title}" FontSize="16" FontWeight="Bold"/>
              <TextBlock Text="{DynamicResource HandTypes.Explain}" Foreground="{DynamicResource Brush.TextDim}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
            <DockPanel>
              <TextBlock Text="{DynamicResource Common.QuickRead}" FontSize="14" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding HandTypeNotes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='• {0}'}" Margin="0,0,0,4"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
            <DockPanel>
              <TextBlock Text="{DynamicResource HandTypes.Chart}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0,0,0,8"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <charts:DivergingBarList Items="{Binding HandTypeBars}" LabelWidth="230" EmptyText="{DynamicResource HandTypes.Empty}"/>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="8,0,0,0">
            <DataGrid ItemsSource="{Binding HandTypeRows}">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Setter Property="FontWeight" Value="{Binding Weight}"/>
                  <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource HandTypes.Col.Type}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource NoWrapCellText}"/>
                <DataGridTextColumn Header="{DynamicResource HandTypes.Col.Hands}" Binding="{Binding Hands}" Width="60" ElementStyle="{StaticResource NoWrapCellText}"/>
                <DataGridTemplateColumn Header="{DynamicResource HandTypes.Col.PerHand}" Width="86">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PerHandTrendIcon}" Foreground="{Binding PerHandTrendBrush}" FontWeight="Bold" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding PerHandLabel}" Style="{StaticResource NoWrapCellText}"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource HandTypes.Col.Margin}" Binding="{Binding MarginLabel}" Width="66" ElementStyle="{StaticResource NoWrapCellText}"/>
                <DataGridTextColumn Header="{DynamicResource HandTypes.Col.Raw}" Binding="{Binding RawPerHandLabel}" Width="84" ElementStyle="{StaticResource NoWrapCellText}"/>
                <DataGridTextColumn Header="{DynamicResource HandTypes.Col.Late}" Binding="{Binding LateLabel}" Width="92" ElementStyle="{StaticResource NoWrapCellText}"/>
                <DataGridTextColumn Header="{DynamicResource HandTypes.Col.Early}" Binding="{Binding EarlyLabel}" Width="92" ElementStyle="{StaticResource NoWrapCellText}"/>
                <DataGridTextColumn Header="{DynamicResource HandTypes.Col.Blinds}" Binding="{Binding BlindsLabel}" Width="92" ElementStyle="{StaticResource NoWrapCellText}"/>
                <DataGridTemplateColumn Header="{DynamicResource HandTypes.Col.Sample}" Width="84">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SampleLabel}" Foreground="{Binding SampleBrush}" FontWeight="SemiBold" Style="{StaticResource NoWrapCellText}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>

        </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource HeroTab.Feedback}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,10,0,0">
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{DynamicResource HeroFeedback.Title}" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="{Binding FeedbackIntro}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextDim}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding FeedbackSummary}" FontWeight="SemiBold" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
              <ItemsControl ItemsSource="{Binding Feedback}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="128"/>
                          <ColumnDefinition Width="72"/>
                          <ColumnDefinition Width="80"/>
                          <ColumnDefinition Width="104"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding VerdictBrush}" CornerRadius="11" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding VerdictText}" Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        <Border Grid.Column="3" Background="{Binding LevelBrush}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                VerticalAlignment="Center" ToolTip="{Binding LevelTip}">
                          <TextBlock Text="{Binding LevelLabel}" Foreground="{Binding LevelInk}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Grid.Column="4" Text="{Binding Advice}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <Border Style="{StaticResource PanelBorder}" BorderBrush="{DynamicResource Brush.Accent}">
              <StackPanel>
                <TextBlock Text="{DynamicResource HeroFeedback.FocusTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                <TextBlock Text="{Binding FeedbackFocus}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>





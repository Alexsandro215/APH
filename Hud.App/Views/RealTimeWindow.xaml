<Window x:Class="Hud.App.Views.RealTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hud.App.Views"
        xmlns:local="clr-namespace:Hud.App.Views"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="{DynamicResource RT.Title}"
        Height="800" Width="940" MinWidth="680" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.AppShell}">

  <Window.Resources>
    <system:Double x:Key="GlobalScale">0.80</system:Double>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.SurfaceText}"/>
    </Style>

    <!-- Fichas de opcion del HUD (modo, tamano, mover) -->
    <Style x:Key="HudChip" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="14" Padding="{TemplateBinding Padding}"
                    Background="{DynamicResource Brush.Inset}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudRadio" TargetType="RadioButton" BasedOn="{StaticResource HudChip}"/>
  </Window.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled">
      <Border>
        <Border.LayoutTransform>
          <ScaleTransform x:Name="RootScale"
                          ScaleX="{Binding ElementName=ScaleProxy, Path=Tag}"
                          ScaleY="{Binding ElementName=ScaleProxy, Path=Tag}"/>
        </Border.LayoutTransform>

        <StackPanel Margin="16">
          <Button HorizontalAlignment="Right"
                  Width="34"
                  Height="34"
                  Padding="0"
                  Content="?"
                  FontSize="18"
                  FontWeight="Bold"
                  Foreground="{DynamicResource Brush.SurfaceText}"
                  Click="BtnDictionary_Click"
                  ToolTip="{DynamicResource RT.HelpTip}"
                  Margin="0,0,0,6"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="ChkCompact" IsChecked="True" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource RT.Compact}"
                         Foreground="{DynamicResource Brush.SurfaceText}"/>
            </CheckBox>
            <TextBlock Text="   " Width="8"/>
            <TextBlock Text="{DynamicResource RT.CompactDesc}"
                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center"/>
          </StackPanel>

          <DockPanel Margin="0,0,0,8" LastChildFill="False">
            <TextBlock x:Name="RtHeaderText" Text="{DynamicResource RT.Header}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.SurfaceText}"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="{DynamicResource RT.FinishSession}"
                      Padding="12,6"
                      Margin="0,0,8,0"
                      Click="BtnFinishSession_Click"/>
              <Button Content="{DynamicResource RT.Detect}"
                      Style="{StaticResource Btn.Accent}"
                      Padding="12,6"
                      Click="BtnDetectTables_Click"/>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="DetectionStatusText"
                     Text="{DynamicResource RT.DetectHint}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,10"/>

          <!-- HUD sobre la mesa: modo, tamano, ocultar el propio, mover y restablecer -->
          <WrapPanel Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Hud.Label}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,6"/>
            <RadioButton x:Name="HudMinimal" GroupName="hudmode" Style="{StaticResource HudRadio}" Content="{DynamicResource Hud.Minimal}" ToolTip="{DynamicResource Hud.MinimalDesc}"/>
            <RadioButton x:Name="HudFull" GroupName="hudmode" Style="{StaticResource HudRadio}" Content="{DynamicResource Hud.Full}" ToolTip="{DynamicResource Hud.FullDesc}" Margin="0,0,16,6"/>
            <TextBlock Text="{DynamicResource Hud.SizeLabel}" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource Brush.TextDim}"/>
            <RadioButton x:Name="HudSmall" GroupName="hudsize" Style="{StaticResource HudRadio}" Content="{DynamicResource Hud.Small}"/>
            <RadioButton x:Name="HudNormal" GroupName="hudsize" Style="{StaticResource HudRadio}" Content="{DynamicResource Hud.Normal}"/>
            <RadioButton x:Name="HudLarge" GroupName="hudsize" Style="{StaticResource HudRadio}" Content="{DynamicResource Hud.Large}" Margin="0,0,16,6"/>
            <CheckBox x:Name="HudHideHero" Content="{DynamicResource Hud.HideMine}" VerticalAlignment="Center" Margin="0,0,16,6"/>
            <ToggleButton x:Name="HudMoveToggle" Style="{StaticResource HudChip}" Content="{DynamicResource Hud.Move}" ToolTip="{DynamicResource Hud.MoveDesc}"/>
            <Button x:Name="HudResetButton" Content="{DynamicResource Hud.Reset}" Padding="10,4" Margin="0,0,0,6" Click="HudResetButton_Click"/>
          </WrapPanel>

          <!-- Solver de entrenamiento encima de la mesa: solo dinero ficticio -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <CheckBox x:Name="HudSolver" Content="{DynamicResource Hud.Solver}" ToolTip="{DynamicResource Hud.SolverDesc}" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <CheckBox x:Name="HudRecap" Content="{DynamicResource Hud.Recap}" ToolTip="{DynamicResource Hud.RecapDesc}" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <CheckBox x:Name="HudGrade" Content="{DynamicResource Hud.Grade}" ToolTip="{DynamicResource Hud.GradeDesc}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="SolverStatusText" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,8"/>
          <views:StatLegendStrip Margin="0,0,0,8"/>

          <!-- Biblioteca GTO del flop: se calcula de antemano (de noche) y se consulta al instante -->
          <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                  Background="{DynamicResource Brush.Inset}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <DockPanel LastChildFill="True">
              <Button x:Name="FlopLibraryButton" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,5" Margin="12,0,0,0"
                      Content="{DynamicResource FlopLib.Start}" Click="FlopLibraryButton_Click"/>
              <StackPanel>
                <TextBlock Text="{DynamicResource FlopLib.Title}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="FlopLibraryText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource Brush.TextDim}"/>
                <ProgressBar x:Name="FlopLibraryBar" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="1" BorderThickness="0"
                             Background="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.Accent}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Tu sesion en vivo (mesas de dinero ficticio con el solver) -->
          <Border x:Name="SessionBar" Visibility="Collapsed" CornerRadius="8" Padding="12,7" Margin="0,0,0,14"
                  Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
            <TextBlock x:Name="SessionBarText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text}"/>
          </Border>

          <StackPanel>
            <local:SlotTail x:Name="Slot1" Margin="0,0,0,6"/>
            <local:SlotTail x:Name="Slot2" Margin="0,0,0,6"/>
            <local:SlotTail x:Name="Slot3" Margin="0,0,0,6"/>
            <local:SlotTail x:Name="Slot4" Margin="0,0,0,6"/>
            <local:SlotTail x:Name="Slot5" Margin="0,0,0,6"/>
            <local:SlotTail x:Name="Slot6" Margin="0,0,0,6"/>
            <local:SlotTail x:Name="Slot7" Margin="0,0,0,6"/>
            <local:SlotTail x:Name="Slot8" Margin="0,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <Label x:Name="ScaleProxy" Visibility="Collapsed" Tag="{StaticResource GlobalScale}"/>
  </Grid>
</Window>




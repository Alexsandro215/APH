<Window x:Class="Hud.App.Views.TrainerCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APH - Calibrar lector de cartas"
        Height="780"
        Width="1240"
        MinHeight="560"
        MinWidth="900"
        Background="{DynamicResource Brush.AppShell}"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DimText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="340"/>
    </Grid.ColumnDefinitions>

    <!-- Captura de la mesa con las zonas -->
    <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="8">
      <Viewbox Stretch="Uniform">
        <Grid x:Name="Surface">
          <Image x:Name="TableImage" Stretch="Fill"/>
          <Canvas x:Name="Overlay"
                  Background="Transparent"
                  Cursor="Cross"
                  MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                  MouseMove="Overlay_MouseMove"
                  MouseLeftButtonUp="Overlay_MouseLeftButtonUp"/>
        </Grid>
      </Viewbox>
    </Border>

    <!-- Controles -->
    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="CALIBRACIÓN" Style="{StaticResource SectionEyebrow}"/>
          <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,8"
                     Text="Lo normal es no hacer nada: al pulsar Iniciar el lector se calibra solo en cuanto ve el flop y tus dos cartas a la vez. Aquí puedes hacerlo a mano o comprobarlo.&#x0a;Automático: con el flop y tus cartas a la vista pulsa Capturar de nuevo y Autocalibrar.&#x0a;Manual: elige una zona de la lista y arrastra un rectángulo sobre la ESQUINA de esa carta (el numero/letra y el palo pequeño de debajo), dejando un poco de blanco alrededor. Repite con las 7 zonas y pulsa Guardar.&#x0a;Usa la baraja de caras blancas (mejor con 4 colores)."/>

          <ListBox x:Name="SlotsList" DisplayMemberPath="Label" Height="190" Margin="0,0,0,8"
                   Background="{DynamicResource Brush.Inset}" Foreground="{DynamicResource Brush.Text}"
                   BorderBrush="{DynamicResource Brush.Border}"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Capturar de nuevo" Style="{StaticResource Btn.Primary}" Click="BtnCapture_Click"/>
            <Button Content="Autocalibrar" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnAuto_Click"/>
            <Button Content="Borrar zona" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnClearSlot_Click"/>
          </StackPanel>
          <TextBlock x:Name="AutoResult" Style="{StaticResource DimText}" Margin="0,0,0,10"/>

          <TextBlock Text="PROBAR" Style="{StaticResource SectionEyebrow}" Margin="0,6,0,4"/>
          <Button Content="Probar lectura en esta captura" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left" Click="BtnTest_Click"/>
          <TextBlock x:Name="TestResult" Style="{StaticResource DimText}" FontFamily="Consolas" Margin="0,6,0,10"/>

          <TextBlock Text="ENSENAR (opcional)" Style="{StaticResource SectionEyebrow}" Margin="0,6,0,4"/>
          <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,6"
                     Text="El lector aprende solo al terminar cada mano. Para acelerar, escribe las cartas que se ven en la captura (ej.: héroe 'Ah Kd', board 'Qs 7h 2c Td 9s')."/>
          <TextBlock Text="Cartas del héroe" Style="{StaticResource DimText}"/>
          <TextBox x:Name="TeachHero" Margin="0,2,0,6"/>
          <TextBlock Text="Board (en orden)" Style="{StaticResource DimText}"/>
          <TextBox x:Name="TeachBoard" Margin="0,2,0,6"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Ensenar estas cartas" Style="{StaticResource Btn.Primary}" Click="BtnTeach_Click"/>
            <Button Content="Borrar lo aprendido" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnForget_Click"/>
          </StackPanel>
          <TextBlock x:Name="TeachResult" Style="{StaticResource DimText}" Margin="0,0,0,10"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancelar" Style="{StaticResource Btn.Primary}" Click="BtnCancel_Click"/>
            <Button Content="Guardar" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnSave_Click"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>

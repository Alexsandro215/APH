<Window x:Class="Hud.App.Views.TrainerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APH - Modo Entrenador"
        Height="820"
        Width="1280"
        MinHeight="620"
        MinWidth="1020"
        Background="{DynamicResource Brush.AppShell}"
        Foreground="{DynamicResource Brush.Text}"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <DataTemplate x:Key="BigCardChips">
      <ItemsControl ItemsSource="{Binding}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="42"
                    Height="56"
                    Margin="0,0,6,0"
                    CornerRadius="6"
                    Background="{Binding Background}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
              <TextBlock Text="{Binding Rank}"
                         Foreground="{Binding Foreground}"
                         FontSize="26"
                         FontWeight="Black"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Cabecera -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="MODO ENTRENADOR" Style="{StaticResource SectionEyebrow}"/>
      <TextBlock Text="Lector de cartas en vivo y corrección de decisiones" Style="{StaticResource SectionHeading}"/>
      <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                 Text="Solo funciona en mesas de DINERO FICTICIO de PokerStars (Hold'em sin límite 6-max). Las mesas de dinero real o de torneo se bloquean: usar ayudas en vivo con dinero real esta prohibido por las salas. La decisión la recomienda APH, pero el clic lo hace siempre el alumno. Iniciar lee UNA mesa en vivo; Corregir todas sigue el historial de todas las mesas de dinero ficticio abiertas y corrige cada decisión al terminar la mano, sin leer la pantalla."/>
    </StackPanel>

    <!-- Seleccion de mesa -->
    <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="12" Margin="0,0,0,10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="BtnDetect" Content="Detectar mesas" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnDetect_Click"/>
          <Button x:Name="BtnCalibrate" Content="Calibrar lector" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnCalibrate_Click"/>
          <Button x:Name="BtnStart" Content="Iniciar en vivo" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnStart_Click"
                  ToolTip="Lee esta mesa en vivo (cartas, equity y decisión en el turno del alumno) y corrige sus manos."/>
          <Button x:Name="BtnGradeAll" Content="Corregir todas" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnGradeAll_Click"
                  ToolTip="Corrige al terminar cada mano todas las mesas de dinero ficticio abiertas (solo con el historial, sin leer la pantalla)."/>
          <Button x:Name="BtnStop" Content="Detener" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnStop_Click" IsEnabled="False"/>
        </StackPanel>
        <TextBlock Text="Mesa:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="TablesCombo" DisplayMemberPath="Label" MinWidth="320" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Estado -->
    <StackPanel Grid.Row="2" Margin="2,0,0,10">
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource Brush.Accent}" FontSize="13"
                 Text="Pulsa &quot;Detectar mesas&quot; con una mesa de dinero ficticio abierta."/>
      <TextBlock x:Name="ReaderText" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
    </StackPanel>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MESAS SEGUIDAS -->
        <Border x:Name="TablesPanel" Grid.Row="0" Style="{StaticResource PanelCard}" Margin="0,0,0,10" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="MESAS SEGUIDAS" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
              <ItemsControl x:Name="TablesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Brush.Inset}" CornerRadius="6" Padding="9,5" Margin="0,0,0,4"
                            BorderBrush="{Binding StateBrush}" BorderThickness="3,0,0,0">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding StateLabel}" FontSize="11" FontWeight="Bold"
                                     Foreground="{Binding StateBrush}" Margin="8,0,0,0"/>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ScoreLine}" Style="{StaticResource DimText}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- EN VIVO -->
        <Border Grid.Row="1" Style="{StaticResource PanelCard}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="PositionText" DockPanel.Dock="Right" FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource Brush.Warning}" Text="Posición: ?"/>
                <TextBlock x:Name="LiveTitle" Text="EN VIVO" Style="{StaticResource SectionEyebrow}"/>
              </DockPanel>

              <!-- Decision en vivo: solo en el turno del alumno -->
              <Border x:Name="DecisionBanner" CornerRadius="10" Padding="14,10" Margin="0,10,0,0"
                      Background="#2D6CDF" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="DECISIÓN EN VIVO" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0.85"/>
                  <TextBlock x:Name="DecisionAction" FontSize="26" FontWeight="Black" Foreground="White" TextWrapping="NoWrap"/>
                  <TextBlock x:Name="DecisionReason" FontSize="13" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <ItemsControl x:Name="DecisionDetailsList" Margin="2,6,0,0" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource DimText}" Margin="0,1"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Héroe" Style="{StaticResource DimText}" Margin="0,10,0,4"/>
              <ContentControl x:Name="HeroCardsView" ContentTemplate="{StaticResource BigCardChips}" MinHeight="56"/>

              <TextBlock Text="Board" Style="{StaticResource DimText}" Margin="0,10,0,4"/>
              <ContentControl x:Name="BoardCardsView" ContentTemplate="{StaticResource BigCardChips}" MinHeight="56"/>

              <TextBlock x:Name="HandText" FontSize="17" FontWeight="Bold" Margin="0,12,0,0" Text="Esperando..."/>

              <Border Background="{DynamicResource Brush.Inset}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock x:Name="EquityText" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock x:Name="PotOddsText" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                  <TextBlock x:Name="OutsText" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <TextBlock Text="PLAN PREFLOP (tablas APH)" Style="{StaticResource SectionEyebrow}" Margin="0,14,0,4"/>
              <ItemsControl x:Name="PlanList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13" Margin="0,1"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="RIVALES EN LA MESA" Style="{StaticResource SectionEyebrow}" Margin="0,14,0,4"/>
              <ItemsControl x:Name="OpponentsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource DimText}" Margin="0,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- DECISIONES -->
      <Border Grid.Column="2" Style="{StaticResource PanelCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Copiar resumen" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnCopy_Click"
                      ToolTip="Copia las decisiones que se ven ahora (respeta el filtro)."/>
              <Button Content="Limpiar" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BtnClear_Click"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="DECISIONES DEL ALUMNO" Style="{StaticResource SectionEyebrow}"/>
              <TextBlock x:Name="ScoreText" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                         Text="Aun no hay manos analizadas."/>
            </StackPanel>
          </DockPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Ver:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <ComboBox x:Name="FilterCombo" MinWidth="200" VerticalAlignment="Center" SelectionChanged="FilterCombo_SelectionChanged"/>
            <CheckBox x:Name="OnlyMistakesCheck" Content="Solo errores y dudosas" Margin="14,0,0,0" VerticalAlignment="Center"
                      Foreground="{DynamicResource Brush.Text}" Checked="OnlyMistakesCheck_Changed" Unchecked="OnlyMistakesCheck_Changed"/>
          </StackPanel>

          <ItemsControl x:Name="DecisionsList" Grid.Row="2"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter/>
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Brush.Inset}" CornerRadius="8" Margin="0,0,0,8"
                        BorderBrush="{Binding GradeBrush}" BorderThickness="3,0,0,0" Padding="12,9">
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Background="{Binding GradeBrush}" CornerRadius="4" Padding="7,1" Margin="0,0,8,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Decision.GradeLabel}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                      </Border>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding HandLine}" Style="{StaticResource DimText}" Margin="8,0,0,0"/>
                      <TextBlock Text="{Binding Decision.Headline}" FontWeight="SemiBold" FontSize="13"/>
                    </DockPanel>
                    <TextBlock Text="{Binding CardsLine}" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Decision.ChoiceLine}" FontSize="13" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Decision.LiveLine}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"
                               Foreground="{Binding LiveBrush}" Visibility="{Binding LiveVisibility}"/>
                    <TextBlock Text="{Binding Decision.Explanation}" FontSize="13" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Decision.FactsText}" Style="{StaticResource DimText}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

                               VerticalAlignment="Center"/>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Main.AccumulatedGain}" Style="{StaticResource CardTitle}"/>
                      <TextBlock Text="{DynamicResource Main.ChartHint}" Style="{StaticResource CardHint}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DockPanel>
                  <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource Brush.Bg}" ClipToBounds="True">
                    <Canvas x:Name="PerformanceChart" ClipToBounds="True" Background="Transparent"
                            SizeChanged="PerformanceChart_SizeChanged"/>
                  </Border>
                </Grid>
              </Border>

              <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="16"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource DashCard}">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource KpiIcon}" VerticalAlignment="Top">
                      <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource Brush.Accent}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Main.BestRecentTen}" Style="{StaticResource KpiLabel}"/>
                      <TextBlock Text="{Binding BestRecentTableSummary}" FontWeight="Bold" FontSize="16" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding BestRecentTableDetail}" Style="{StaticResource CardHint}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource DashCard}">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource KpiIcon}" VerticalAlignment="Top">
                      <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource Brush.Negative}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Main.WorstRecentTen}" Style="{StaticResource KpiLabel}"/>
                      <TextBlock Text="{Binding WorstRecentTableSummary}" FontWeight="Bold" FontSize="16" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding WorstRecentTableDetail}" Style="{StaticResource CardHint}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </Grid>
            </Grid>

            <!-- Mesas recientes -->
            <Border Style="{StaticResource DashCard}">
              <StackPanel>
                <DockPanel x:Name="RecentTablesProHeader" Margin="0,0,0,12">
                  <Button DockPanel.Dock="Right" Click="BtnAll_Click" Padding="12,6"
                          AutomationProperties.Name="{DynamicResource Main.RailTables}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource Main.RailTables}" TextWrapping="NoWrap"/>
                      <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Main.RecentTables}" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="{DynamicResource Main.SessionFlow}" Style="{StaticResource CardHint}"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock x:Name="RecentTablesLiteHeader" Text="{DynamicResource Main.RecentTables}" Style="{StaticResource CardTitle}"
                           Margin="0,0,0,10" Visibility="Collapsed"/>

                <DataGrid x:Name="RecentTablesGrid"
                          ItemsSource="{Binding RecentTables}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          RowHeight="36"
                          MinHeight="120"
                          VerticalScrollBarVisibility="Disabled"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource Brush.Inset}"
                          Cursor="Hand"
                          ToolTip="{DynamicResource Common.OpenTableDetail}"
                          MouseDoubleClick="RecentTablesGrid_MouseDoubleClick">
                  <DataGrid.Resources>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                      <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                  </DataGrid.Resources>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{DynamicResource Grid.Table}" Width="2.4*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TableName}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="NoWrap">
                              <Run Text="{Binding GameFormat, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding PlayedDate, Mode=OneWay}"/>
                            </TextBlock>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource Grid.Hands}" Binding="{Binding HandsReceived}" Width="0.7*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="VPIP" Binding="{Binding VPIPPct, StringFormat={}{0:0.#}%}" Width="0.7*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PFR" Binding="{Binding PFRPct, StringFormat={}{0:0.#}%}" Width="0.7*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="3BET" Binding="{Binding ThreeBetPct, StringFormat={}{0:0.#}%}" Width="0.7*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="AF" Binding="{Binding AF, StringFormat={}{0:0.#}}" Width="0.6*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CBET" Binding="{Binding CBetFlopPct, StringFormat={}{0:0.#}%}" Width="0.7*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="WTSD" Binding="{Binding WTSDPct, StringFormat={}{0:0.#}%}" Width="0.7*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="W$SD" Binding="{Binding WSDPct, StringFormat={}{0:0.#}%}" Width="0.7*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="{DynamicResource Grid.FinalBb}" Width="1.1*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Right" Margin="0,0,10,0">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="#33E24E5B"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsWin}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding TrendIcon}" FontWeight="Bold" Margin="0,0,5,0" FontSize="10" VerticalAlignment="Center">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Negative}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsWin}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock Text="{Binding NetBb, StringFormat={}{0:+0.#;-0.#;0} bb}" FontWeight="Bold"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </ContentControl>

      <!-- Mientras se leen las manos: la pica de APH girando encima de la pagina -->
      <Border x:Name="LoadingOverlay" Grid.Row="1" Background="{DynamicResource Brush.Bg}" Opacity="0.94"
              Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <views:SpadeLoader Margin="0,0,0,18"/>
          <TextBlock Text="{DynamicResource Common.LoadingHands}" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>

    <!-- Se oscurece mientras hay una ventana de dialogo abierta encima (Configuración, salas...) -->
    <Border x:Name="DimOverlay" Background="#000000" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"/>

    <!-- Avisos que aparecen abajo a la derecha y se van solos -->
    <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"
                Width="380"/>
  </Grid>
</Window>

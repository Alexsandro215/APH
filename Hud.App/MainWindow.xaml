<Window x:Class="Hud.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hud.App.Views"
        xmlns:motion="clr-namespace:Hud.App.Services"
        Title="{DynamicResource App.Title}"
        Height="900" Width="1600"
        MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterScreen">

  <!--
    Diseno de una sola ventana: menu lateral con secciones, barra superior con "Volver" y un
    area de paginas. Las funciones de analisis se muestran aqui dentro (MainWindow.Navigation.cs);
    Tiempo real y Modo Entrenador siguen en ventanas propias para ponerlas junto a las mesas.
  -->

  <Window.Resources>
    <views:StatToBrushConverter x:Key="StatToBrush"/>
    <views:StatTextBrushConverter x:Key="StatTextBrush"/>
    <views:BoolToModeConverter x:Key="BoolToModeConverter"/>

    <Style x:Key="ChartToolTipStyle" TargetType="ToolTip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Placement" Value="Top"/>
      <Setter Property="VerticalOffset" Value="-8"/>
      <Setter Property="HasDropShadow" Value="False"/>
    </Style>

    <Style x:Key="ModernSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Grid x:Name="SwitchRoot" Width="40" Height="20" Margin="0,0,8,0">
                <Border x:Name="Background" CornerRadius="10" Background="{DynamicResource Brush.Inset}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
                <Border x:Name="Thumb" HorizontalAlignment="Left" Width="14" Height="14" Margin="3" CornerRadius="7" Background="{DynamicResource Brush.TextDim}"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Background" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                <Setter TargetName="Background" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Titulo de seccion del menu (PRINCIPAL, ANALISIS, EN VIVO) -->
    <Style x:Key="NavSection" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Opacity" Value="0.75"/>
      <Setter Property="Margin" Value="12,18,0,6"/>
    </Style>

    <!-- Elemento del menu que abre una pagina: queda marcado mientras la pagina esta abierta.
         El fondo al pasar el raton aparece con un fundido y la marca de la izquierda crece al elegirlo. -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="GroupName" Value="MainNav"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Height="38">
              <Border x:Name="Hover" Background="{DynamicResource Brush.CardHover}" CornerRadius="8" Opacity="0"/>
              <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,0">
                <Grid>
                  <Border x:Name="Marker" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                          Margin="-12,0,0,0" Background="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                      <ScaleTransform ScaleY="0"/>
                    </Border.RenderTransform>
                  </Border>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Width="22" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                    <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="1" Duration="0:0:0.26">
                        <DoubleAnimation.EasingFunction>
                          <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="0" Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Elemento del menu que hace una accion o abre una ventana aparte -->
    <Style x:Key="NavAction" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Height="38">
              <Border x:Name="Hover" Background="{DynamicResource Brush.CardHover}" CornerRadius="8" Opacity="0"/>
              <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,0">
                <DockPanel VerticalAlignment="Center">
                  <TextBlock x:Name="Icon" DockPanel.Dock="Left" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                             Width="22" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                  <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </DockPanel>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Inset}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Boton de solo icono de la barra de abajo del menu (salas, modo lite, cerrar sesion) -->
    <Style x:Key="NavIcon" TargetType="Button" BasedOn="{StaticResource NavAction}">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Height="50">
              <Border x:Name="Hover" Background="{DynamicResource Brush.CardHover}" CornerRadius="8" Opacity="0"/>
              <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="2,0">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"
                             Foreground="{TemplateBinding Foreground}"/>
                  <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center"
                             TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                             Foreground="{TemplateBinding Foreground}"/>
                </StackPanel>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Inset}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tarjeta del panel -->
    <Style x:Key="DashCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="CardHint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Indicador grande (Manos, Mesas, Ganancia, Winrate) -->
    <Style x:Key="KpiTile" TargetType="Border" BasedOn="{StaticResource DashCard}">
      <Setter Property="Margin" Value="0,0,14,0"/>
      <Setter Property="Padding" Value="18,16"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.HeaderBorder}"/>
          <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="KpiIcon" TargetType="Border">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
      <Setter Property="Margin" Value="0,0,14,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="KpiLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Las cifras grandes suben contando cuando cambian (se apaga en Configuracion > Apariencia) -->
    <Style x:Key="KpiValue" TargetType="TextBlock">
      <Setter Property="motion:UiMotion.CountUp" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- Casilla de estadistica del heroe -->
    <Style x:Key="StatTile" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="StatTileLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Opacity" Value="0.85"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatTileLevel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Opacity" Value="0.9"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <Style x:Key="StatTileValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource Brush.AppShell}">
  <Grid x:Name="ShellRoot">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===================== MENU LATERAL ===================== -->
    <Border Grid.Column="0"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="12,18,12,12">
        <DockPanel.Resources>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
          </Style>
        </DockPanel.Resources>

        <!-- Marca -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
          <!-- Pica dibujada como figura: el caracter de la fuente quedaba bajo dentro del cuadro -->
          <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.Accent}">
            <Path Width="20" Height="22" Stretch="Uniform" Fill="{DynamicResource Brush.Bg}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M12,1 C12,1 2.5,8.2 2.5,13.6 C2.5,16.9 4.8,19.1 7.8,19.1 C9.4,19.1 10.7,18.4 11.3,17.3 C11.1,19.6 10,21.4 8.3,23 L15.7,23 C14,21.4 12.9,19.6 12.7,17.3 C13.3,18.4 14.6,19.1 16.2,19.1 C19.2,19.1 21.5,16.9 21.5,13.6 C21.5,8.2 12,1 12,1 Z"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="APH" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Analyzer Poker Hands" FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
          </StackPanel>
        </StackPanel>

        <!-- Sala activa -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Inset}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,4">
          <StackPanel>
            <TextBlock x:Name="ActiveRoomLabel" Text="{DynamicResource Main.ActiveRoom}" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.TextDim}" Margin="2,0,0,6"/>
            <ComboBox x:Name="PokerRoomCombo" Height="32" HorizontalAlignment="Stretch"
                      SelectionChanged="PokerRoomCombo_SelectionChanged"
                      AutomationProperties.Name="{DynamicResource Main.ActiveRoom}"/>
          </StackPanel>
        </Border>

        <!-- Acciones de abajo: Configuración en una fila y, debajo, tres botones de icono para que el
             menu de arriba quepa entero sin barra de desplazamiento. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="6,0,6,8"/>
          <Button Style="{StaticResource NavAction}" Tag="&#xE713;" Click="BtnSettings_Click"
                  ToolTip="{DynamicResource Settings.Subtitle}" AutomationProperties.Name="{DynamicResource Main.SettingsTip}">
            <TextBlock Text="{DynamicResource Main.SettingsTip}"/>
          </Button>
          <UniformGrid Columns="3" Margin="0,4,0,0">
            <Button Style="{StaticResource NavIcon}" Tag="&#xE8B7;" Content="{DynamicResource Main.RailRooms}" Click="BtnPickFolder_Click"
                    ToolTip="{DynamicResource Main.RailRoomsDesc}" AutomationProperties.Name="{DynamicResource Main.RailRooms}"/>
            <Button x:Name="LiteModeButton" Style="{StaticResource NavIcon}" Tag="&#xE8A9;" Content="{DynamicResource Main.RailLiteMode}"
                    Click="BtnLiteMode_Click" ToolTip="{DynamicResource Main.RailLiteModeDesc}"
                    AutomationProperties.Name="{DynamicResource Main.RailLiteMode}"/>
            <Button Style="{StaticResource NavIcon}" Tag="&#xE8AC;" Content="{DynamicResource Main.RailLogout}" Click="BtnLogout_Click"
                    ToolTip="{DynamicResource Main.RailLogoutDesc}" AutomationProperties.Name="{DynamicResource Main.RailLogout}"/>
          </UniformGrid>
        </StackPanel>

        <!-- Navegacion -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="{DynamicResource Main.NavSectionMain}" Style="{StaticResource NavSection}"/>
            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" Tag="&#xE80F;" IsChecked="True"
                         Click="NavDashboard_Click" AutomationProperties.Name="{DynamicResource Main.NavDashboard}">
              <TextBlock Text="{DynamicResource Main.NavDashboard}"/>
            </RadioButton>
            <RadioButton x:Name="NavHeroProfile" Style="{StaticResource NavItem}" Tag="&#xE77B;"
                         Click="BtnHeroProfile_Click" ToolTip="{DynamicResource Main.RailHeroProfileDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailHeroProfile}">
              <TextBlock Text="{DynamicResource Main.RailHeroProfile}"/>
            </RadioButton>

            <TextBlock Text="{DynamicResource Main.NavSectionAnalysis}" Style="{StaticResource NavSection}"/>
            <RadioButton x:Name="NavTables" Style="{StaticResource NavItem}" Tag="&#xE9D2;"
                         Click="BtnAll_Click" ToolTip="{DynamicResource Main.RailTablesDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailTables}">
              <TextBlock Text="{DynamicResource Main.RailTables}"/>
            </RadioButton>
            <RadioButton x:Name="NavMyTables" Style="{StaticResource NavItem}" Tag="&#xE8A5;"
                         Click="BtnOne_Click" ToolTip="{DynamicResource Main.RailMyTablesDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailMyTables}">
              <TextBlock Text="{DynamicResource Main.RailMyTables}"/>
            </RadioButton>
            <RadioButton x:Name="NavGain" Style="{StaticResource NavItem}" Tag="&#xE8A1;"
                         Click="BtnGain_Click" ToolTip="{DynamicResource Main.RailGainDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailGain}">
              <TextBlock Text="{DynamicResource Main.RailGain}"/>
            </RadioButton>
            <RadioButton x:Name="NavVillains" Style="{StaticResource NavItem}" Tag="&#xE716;"
                         Click="BtnBestWorst_Click" ToolTip="{DynamicResource Main.RailVillainsDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailVillains}">
              <TextBlock Text="{DynamicResource Main.RailVillains}"/>
            </RadioButton>
            <RadioButton x:Name="NavLeaks" Style="{StaticResource NavItem}" Tag="&#xE9D9;"
                         Click="BtnLeakFinder_Click" ToolTip="{DynamicResource Main.RailLeaksDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailLeaks}">
              <TextBlock Text="{DynamicResource Main.RailLeaks}"/>
            </RadioButton>
            <RadioButton x:Name="NavSessions" Style="{StaticResource NavItem}" Tag="&#xE8A7;"
                         Click="BtnSessions_Click" ToolTip="{DynamicResource Main.RailSessionsDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailSessions}">
              <TextBlock Text="{DynamicResource Main.RailSessions}"/>
            </RadioButton>

            <TextBlock Text="{DynamicResource Main.NavSectionLive}" Style="{StaticResource NavSection}"/>
            <RadioButton x:Name="NavPreflop" Style="{StaticResource NavItem}" Tag="&#xE80A;"
                         Click="BtnPreflop_Click" ToolTip="{DynamicResource Main.RailPreflopDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailPreflop}">
              <TextBlock Text="{DynamicResource Main.RailPreflop}"/>
            </RadioButton>
            <RadioButton x:Name="NavPractice" Style="{StaticResource NavItem}" Tag="&#xE9D5;"
                         Click="BtnPractice_Click" ToolTip="{DynamicResource Main.RailPracticeDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailPractice}">
              <TextBlock Text="{DynamicResource Main.RailPractice}"/>
            </RadioButton>
            <RadioButton x:Name="NavSimulator" Style="{StaticResource NavItem}" Tag="&#xE7FC;"
                         Click="BtnSimulator_Click" ToolTip="{DynamicResource Main.RailSimulatorDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailSimulator}">
              <TextBlock Text="{DynamicResource Main.RailSimulator}"/>
            </RadioButton>
            <RadioButton x:Name="NavPushFold" Style="{StaticResource NavItem}" Tag="&#xE945;"
                         Click="BtnPushFold_Click" ToolTip="{DynamicResource Main.RailPushFoldDesc}"
                         AutomationProperties.Name="{DynamicResource Main.RailPushFold}">
              <TextBlock Text="{DynamicResource Main.RailPushFold}"/>
            </RadioButton>
            <Button Style="{StaticResource NavAction}" Tag="&#xE916;" Click="BtnRT_Click"
                    ToolTip="{DynamicResource Main.RailRealTimeDesc}" AutomationProperties.Name="{DynamicResource Main.RailRealTime}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Main.RailRealTime}"/>
              </DockPanel>
            </Button>
            <Button Style="{StaticResource NavAction}" Tag="&#xE7BE;" Click="BtnTrainer_Click"
                    ToolTip="Lector de cartas en vivo y corrección de decisiones. Solo dinero ficticio." AutomationProperties.Name="Modo Entrenador">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                <TextBlock Text="Modo Entrenador"/>
              </DockPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ===================== AREA DE PAGINAS ===================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Barra superior: volver, titulo de la pagina y estado -->
      <Border Grid.Row="0" Padding="24,14,24,12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
              Background="{DynamicResource Brush.Bg}">
        <DockPanel>
          <DockPanel.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
              <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>
          </DockPanel.Resources>
          <Button x:Name="BackButton" DockPanel.Dock="Left" Visibility="Collapsed" Click="BackButton_Click"
                  Padding="12,6" Margin="0,0,16,0" VerticalAlignment="Center"
                  AutomationProperties.Name="{DynamicResource Main.NavBack}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="{DynamicResource Main.NavBack}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="460">
            <TextBlock x:Name="LastSessionText" Text="{DynamicResource Main.LastSession}" HorizontalAlignment="Right"
                       Foreground="{DynamicResource Brush.TextDim}" FontSize="12"/>
            <TextBlock x:Name="InfoText" Text="{DynamicResource Main.Waiting}" Foreground="{DynamicResource Brush.Accent}"
                       FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitleText" Text="{DynamicResource Main.NavDashboard}" FontSize="22" FontWeight="Bold"/>
